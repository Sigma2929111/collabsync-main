const http = require("http");
const fs = require("fs");
const path = require("path");
const crypto = require("crypto");
const { detectRadminIPv4, isLoopbackRequest } = require("./radmin-network");
const { WebSocketServer } = require("ws");
const jwt = require("jsonwebtoken");
const { normalizePermissions, canApplyDelta } = require("./permissions");

const PORT = process.env.PORT || 3001;
const JWT_SECRET = process.env.JWT_SECRET || "";
if (JWT_SECRET.length < 32) throw new Error("JWT_SECRET must be set and contain at least 32 characters");
const HOST_PUBLIC_URL = process.env.HOST_PUBLIC_URL || "";

const CHUNK_SIZE = 200;
const CHUNK_DELAY_MS = 60;
const MAX_HISTORY = 8000; // Ограничение истории по числу событий
const DATA_DIR = process.env.COLLABSYNC_DATA_DIR || path.join(__dirname, ".collabsync-data");
const STATE_FILE = path.join(DATA_DIR, "server2-state.json");
let persistTimer = null, persistQueue = Promise.resolve();
async function flushPersistentRooms() {
    if (persistTimer) { clearTimeout(persistTimer); persistTimer = null; }
    const state = { version: 1, rooms: [...rooms.entries()].filter(([, r]) => r.persistent).map(([id, r]) => [id, { snapshot: r.snapshot, history: r.history.slice(-MAX_HISTORY), hostUserId: r.hostUserId, lastHostPing: r.lastHostPing, permissions: r.permissions, backupSettings: r.backupSettings, backups: r.backups, activity: r.activity }]) };
    const data = JSON.stringify(state);
    persistQueue = persistQueue.catch(() => {}).then(async () => {
        await fs.promises.mkdir(DATA_DIR, { recursive: true });
        const tmp = STATE_FILE + ".tmp";
        await fs.promises.writeFile(tmp, data, { mode: 0o600 });
        await fs.promises.rename(tmp, STATE_FILE);
    });
    await persistQueue;
}
function schedulePersist() {
    if (persistTimer) clearTimeout(persistTimer);
    persistTimer = setTimeout(() => { persistTimer = null; flushPersistentRooms().catch(e => console.error("[Persistence] room save failed:", e.message)); }, 250);
}
async function restorePersistentRooms() {
    try {
        const state = JSON.parse(await fs.promises.readFile(STATE_FILE, "utf8"));
        if (state.version !== 1 || !Array.isArray(state.rooms)) throw new Error("unsupported Server 2 state format");
        for (const [id, saved] of state.rooms) {
            if (typeof id !== "string" || !saved || !Array.isArray(saved.snapshot) || !Array.isArray(saved.history)) continue;
            rooms.set(id, { clients: new Map(), snapshot: saved.snapshot, history: saved.history.slice(-MAX_HISTORY), hostUserId: Number(saved.hostUserId) || null, lastHostPing: Number(saved.lastHostPing) || Date.now(), persistent: true, permissions: saved.permissions && typeof saved.permissions === "object" ? saved.permissions : {}, backupSettings: saved.backupSettings || {enabled:false, intervalMs:86400000, retention:20, lastBackupAt:0}, backups: Array.isArray(saved.backups) ? saved.backups : [], activity: Array.isArray(saved.activity) ? saved.activity.slice(-500) : [] });
        }
        console.log(`[Persistence] restored ${rooms.size} persistent Server 2 rooms`);
    } catch (e) { if (e.code !== "ENOENT") console.error("[Persistence] Server 2 restore failed:", e.message); }
}
const MAX_ROOM_CLIENTS = 32;
const WS_MESSAGES_PER_10S = 180;
const CHAT_MESSAGES_PER_10S = 6;
const ALLOWED_DELTA_KINDS = new Set(["create", "update", "delete", "select", "camera"]);

const rooms = new Map();

function getRoom(lobbyId) {
    if (!rooms.has(lobbyId)) {
        rooms.set(lobbyId, { clients: new Map(), snapshot: [], history: [], hostUserId: null, lastHostPing: Date.now(), persistent: false, permissions: {}, locks: new Map(), backupSettings: {enabled:false, intervalMs:86400000, retention:20, lastBackupAt:0}, backups: [], activity: [] });
    }
    return rooms.get(lobbyId);
}

async function readJsonBody(req) {
    const chunks = [];
    let size = 0;
    for await (const chunk of req) {
        size += chunk.length;
        if (size > 1024 * 1024) throw new Error("request body too large");
        chunks.push(chunk);
    }
    if (!chunks.length) return {};
    return JSON.parse(Buffer.concat(chunks).toString("utf8"));
}
function sendJson(res, status, value) {
    res.writeHead(status, {"Content-Type":"application/json", "Cache-Control":"no-store"});
    res.end(JSON.stringify(value));
}
function getAuthorizedWorkspace(req, res, lobbyId) {
    const auth = String(req.headers.authorization || "");
    const token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    let claims;
    try { claims = jwt.verify(token, JWT_SECRET); }
    catch (_) { sendJson(res, 401, {error:"unauthorized"}); return null; }
    const room = rooms.get(lobbyId);
    if (!room) { sendJson(res, 404, {error:"workspace not found"}); return null; }
    if (!claims.isHost || claims.lobbyId !== lobbyId || Number(claims.userId) !== Number(room.hostUserId)) {
        sendJson(res, 403, {error:"owner required"}); return null;
    }
    if (!room.persistent) { sendJson(res, 409, {error:"persistent workspace required"}); return null; }
    return room;
}
async function handleWorkspaceApi(req, res, url) {
    const backupList = url.pathname.match(/^\/api\/workspace\/([^/]+)\/backups$/);
    const activityList = url.pathname.match(/^\/api\/workspace\/([^/]+)\/activity$/);
    if (req.method === "GET" && backupList) {
        const lobbyId = decodeURIComponent(backupList[1]);
        const room = getAuthorizedWorkspace(req, res, lobbyId); if (!room) return true;
        sendJson(res, 200, {settings:room.backupSettings, backups:room.backups.map(({id,createdAt,reason,snapshotSize})=>({id,createdAt,reason,snapshotSize}))});
        return true;
    }
    if (req.method === "GET" && activityList) {
        const lobbyId = decodeURIComponent(activityList[1]);
        const room = getAuthorizedWorkspace(req, res, lobbyId); if (!room) return true;
        sendJson(res, 200, {activity:room.activity.slice(-50)}); return true;
    }
    if (req.method !== "POST" || !["/api/workspace/backups/settings","/api/workspace/backups/create","/api/workspace/backups/restore"].includes(url.pathname)) return false;
    let body;
    try { body = await readJsonBody(req); }
    catch (e) { sendJson(res, 400, {error:e.message === "request body too large" ? e.message : "invalid JSON"}); return true; }
    const lobbyId = String(body.lobbyId || "");
    const room = getAuthorizedWorkspace(req, res, lobbyId); if (!room) return true;
    if (url.pathname.endsWith("/settings")) {
        const intervalMs = Number(body.intervalMs || 86400000), retention = Number(body.retention || 20);
        if (!Number.isSafeInteger(intervalMs) || intervalMs < 3600000 || intervalMs > 2592000000 || !Number.isInteger(retention) || retention < 1 || retention > 100) {
            sendJson(res, 400, {error:"invalid backup settings"}); return true;
        }
        room.backupSettings = {enabled:body.enabled === true, intervalMs, retention, lastBackupAt:room.backupSettings?.lastBackupAt || 0};
        room.backups = room.backups.slice(-retention);
        schedulePersist(); sendJson(res, 200, {ok:true, settings:room.backupSettings}); return true;
    }
    if (url.pathname.endsWith("/create")) {
        if (!room.snapshot.length) { sendJson(res, 409, {error:"no snapshot available"}); return true; }
        const backup = {id:crypto.randomUUID(), createdAt:Date.now(), reason:"manual", snapshot:room.snapshot, history:room.history.slice(-MAX_HISTORY), snapshotSize:room.snapshot.length};
        room.backups = [...room.backups, backup].slice(-room.backupSettings.retention);
        room.backupSettings.lastBackupAt = Date.now();
        schedulePersist();
        sendJson(res, 200, {ok:true, backup:{id:backup.id,createdAt:backup.createdAt,snapshotSize:backup.snapshotSize}}); return true;
    }
    if (url.pathname.endsWith("/restore")) {
        const backup = room.backups.find(item => item.id === body.backupId);
        if (!backup) { sendJson(res, 404, {error:"backup not found"}); return true; }
        if (room.snapshot.length) {
            const safety = {id:crypto.randomUUID(),createdAt:Date.now(),reason:"pre-restore",snapshot:room.snapshot,history:room.history,snapshotSize:room.snapshot.length};
            room.backups = [...room.backups,safety].slice(-room.backupSettings.retention);
        }
        room.snapshot = backup.snapshot;
        room.history = Array.isArray(backup.history) ? backup.history : [];
        schedulePersist();
        sendJson(res, 200, {ok:true,restoredBackupId:backup.id,snapshotSize:room.snapshot.length,note:"Reconnect the Studio plugin to load the restored snapshot."}); return true;
    }
    return false;
}

const server = http.createServer(async (req, res) => {
    const requestUrl = new URL(req.url, "http://localhost");
    if (requestUrl.pathname.startsWith("/api/workspace/")) {
        try { if (await handleWorkspaceApi(req, res, requestUrl)) return; }
        catch (e) { console.error("[Workspace API]", e.message); if (!res.headersSent) sendJson(res, 500, {error:"internal server error"}); return; }
    }
    if (req.url === "/health") {
        res.writeHead(200, {"Content-Type":"application/json"});
        res.end(JSON.stringify({ok:true, rooms:rooms.size, ts:Date.now()}));
        return;
    }
    if (req.url === "/network-info") {
        if (!isLoopbackRequest(req)) { res.writeHead(403); res.end(); return; }
        const adapter = detectRadminIPv4();
        res.writeHead(200, {"Content-Type":"application/json", "Cache-Control":"no-store"});
        res.end(JSON.stringify({ok:true, radminIp:adapter?.address || null, adapter:adapter?.name || null, port:Number(PORT)}));
        return;
    }
    res.writeHead(404); res.end();
});

const wss = new WebSocketServer({ server, path: "/ws", maxPayload: 50 * 1024 * 1024 }); // 50MB limit

function broadcast(room, msg, except=null) {
    const data = JSON.stringify(msg);
    for (const [ws] of room.clients) {
        if (ws !== except && ws.readyState === 1) {
            try { ws.send(data); } catch(e){}
        }
    }
}

function sendPlayers(room) {
    const players = [];
    for (const [, info] of room.clients) {
        players.push({userId:info.userId, userName:info.userName, isHost:info.isHost, isTester:info.isTester, permissions:info.permissions, roles: {isTester: info.isTester}});
    }
    broadcast(room, {type:"players", players});
}

async function sendSnapshotChunks(ws, room) {
    for (let i = 0; i < room.snapshot.length; i += CHUNK_SIZE) {
        try { 
            ws.send(JSON.stringify({
                type:"snapshot_chunk", 
                chunk:room.snapshot.slice(i, i+CHUNK_SIZE), 
                index:i, 
                total:room.snapshot.length
            })); 
        } catch(e){ return; }
        await new Promise(r => setTimeout(r, CHUNK_DELAY_MS));
    }
    if (room.history.length > 0) {
        try { ws.send(JSON.stringify({type:"history", data:room.history})); } catch(e){}
    }
}

// Защита от фантомных лобби: проверка хоста каждые 10 секунд
const cleanupTimer = setInterval(() => {
    const now = Date.now();
    for (const [lobbyId, room] of rooms.entries()) {
        if (room.hostUserId && !room.persistent) {
            let hostOnline = false;
            for (const [, info] of room.clients) {
                if (info.userId === room.hostUserId && info.isHost) {
                    hostOnline = true;
                    break;
                }
            }
            if (!hostOnline && (now - room.lastHostPing > 15000)) {
                console.log(`[Phantom Lobby] Host missing for ${lobbyId}, cleaning up`);
                broadcast(room, {type:"host_left"});
                setTimeout(() => {
                    for (const [c] of room.clients) { try { c.close(); } catch(e){} }
                    room.clients.clear();
                    rooms.delete(lobbyId);
                }, 1000);
            }
        }
    }
}, 10000);

wss.on("connection", (ws) => {
    let lobbyId=null, myUserId=null, myUserName=null, myIsHost=false, myIsTester=false;
    ws._csRate = { startedAt: Date.now(), count: 0 };

    ws.on("message", (raw) => {
        const rateNow = Date.now();
        if (rateNow - ws._csRate.startedAt >= 10000) ws._csRate = { startedAt: rateNow, count: 0 };
        ws._csRate.count++;
        if (ws._csRate.count > WS_MESSAGES_PER_10S) { try { ws.close(1008, "rate limit"); } catch(e){} return; }
        let msg;
        try { msg = JSON.parse(raw.toString()); } catch(e) { return; }
        if (!msg || typeof msg !== "object") return;
        
        if (msg.type === "hello") {
            let decoded;
            try {
                decoded = jwt.verify(msg.token, JWT_SECRET);
                lobbyId = decoded.lobbyId;
                if (typeof decoded.lobbyId !== "string" || !decoded.lobbyId || !Number.isSafeInteger(Number(decoded.userId)) || Number(decoded.userId) <= 0) {
                    throw new Error("invalid token claims");
                }
                myUserId = Number(decoded.userId);
                myUserName = String(decoded.userName || myUserId).slice(0, 32);
                myIsHost = decoded.isHost === true;
                myIsTester = decoded.isTester === true;
            } catch(e) {
                try { ws.send(JSON.stringify({type:"error", message:"bad token"})); } catch(x){}
                try { ws.close(); } catch(x){}
                return;
            }
            
            const room = getRoom(lobbyId);
            room.persistent = room.persistent || decoded.persistent === true;
            if (!room.permissions) room.permissions = {};
            const myPermissions = normalizePermissions(room.permissions[myUserId]);
            for (const [oldWs, info] of room.clients.entries()) {
                if (info.userId === myUserId) {
                    try { oldWs.close(); } catch(e) {}
                    room.clients.delete(oldWs);
                }
            }

            // Защита: если это не хост, а хост еще не подключился или отключился
            if (!myIsHost) {
                if (!room.hostUserId) {
                    try { ws.send(JSON.stringify({type:"error", message:"waiting for host"})); } catch(e){}
                    ws.close();
                    return;
                }
                let hostOnline = false;
                for (const [, info] of room.clients) {
                    if (info.userId === room.hostUserId && info.isHost) { hostOnline = true; break; }
                }
                if (!hostOnline) {
                    try { ws.send(JSON.stringify({type:"error", message:"host offline"})); } catch(e){}
                    ws.close();
                    return;
                }
            } else {
                room.hostUserId = myUserId;
                room.lastHostPing = Date.now();
            }
            
            if (room.clients.size >= MAX_ROOM_CLIENTS) {
                try { ws.send(JSON.stringify({type:"error", message:"lobby full"})); } catch(e){}
                try { ws.close(1008, "lobby full"); } catch(e){}
                return;
            }
            room.clients.set(ws, { userId: myUserId, userName: myUserName, isHost: myIsHost, isTester: myIsTester, permissions: myPermissions, roles: { isTester: myIsTester }, chatWindow: {startedAt: Date.now(), count: 0} });
            
            try {
                ws.send(JSON.stringify({
                    type:"welcome", lobbyId,
                    snapshotSize: room.snapshot.length,
                    players: [...room.clients.values()].map(v=>({userId:v.userId, userName:v.userName, isHost:v.isHost, isTester:v.isTester, permissions:v.permissions, roles:{isTester:v.isTester}})),
                }));
            } catch(e){}
            
            sendSnapshotChunks(ws, room).catch(()=>{});
            sendPlayers(room);
            return;
        }
        
        if (!lobbyId) return;
        const room = getRoom(lobbyId);
        const clientInfo = room.clients.get(ws);
        
        if (msg.type === "request_snapshot") {
            if (clientInfo) sendSnapshotChunks(ws, room).catch(()=>{});
            return;
        }
        
        // Роли нельзя назначать сообщением клиента: они берутся только из подписанного JWT.
        
        if (msg.type === "snapshot") {
            // Только хост может отправлять полный снапшот
            if (clientInfo && clientInfo.isHost && !clientInfo.isTester && Array.isArray(msg.data) && msg.data.length <= 60000) {
                room.snapshot = msg.data;
                room.history = [];
                if (room.persistent) schedulePersist();
                console.log(`[Snapshot] ${lobbyId}: ${room.snapshot.length} items`);
            }
            return;
        }
        
        if (msg.type === "delta") {
            if (!clientInfo || !ALLOWED_DELTA_KINDS.has(msg.kind)) return;
            if (clientInfo.isTester && msg.kind !== "camera") return;
            if (!clientInfo.isHost && !canApplyDelta(clientInfo.permissions, msg)) return;
            if (typeof msg.id !== "string" || msg.id.length > 128) return;
            if (msg.kind !== "camera" && (typeof msg.id !== "string" || !msg.id)) return;
            const lockId = String(msg.objectId || msg.id || "");
            const objectLock = room.locks?.get(lockId);
            if (objectLock && objectLock.expiresAt > Date.now() && objectLock.userId !== clientInfo.userId) {
                try { ws.send(JSON.stringify({type:"lock_conflict", objectId:lockId, userId:objectLock.userId, userName:objectLock.userName, expiresAt:objectLock.expiresAt})); } catch (_) {}
                return;
            }
            if (objectLock && objectLock.expiresAt <= Date.now()) room.locks.delete(lockId);
            if (msg.kind === "camera" && (!Array.isArray(msg.cframe) || msg.cframe.length !== 12 || !msg.cframe.every(Number.isFinite))) return;
            if ((msg.kind === "create" || msg.kind === "update") && (!msg.props || typeof msg.props !== "object" || Array.isArray(msg.props))) return;
            if (msg.kind === "create" && (typeof msg.className !== "string" || typeof msg.name !== "string" || typeof msg.parentId !== "string")) return;
            const trustedDelta = { ...msg, userId: clientInfo.userId, userName: clientInfo.userName };
            if (msg.kind !== "camera") {
                room.history.push(trustedDelta);
                if (room.history.length > MAX_HISTORY) room.history.shift();
                if (room.persistent) {
                    room.activity.push({id:msg.id, kind:msg.kind, userId:clientInfo.userId, userName:clientInfo.userName, ts:Date.now(), objectName:typeof msg.name === "string" ? msg.name.slice(0,100) : null});
                    if (room.activity.length > 500) room.activity.shift();
                    schedulePersist();
                }
            }
            broadcast(room, trustedDelta, ws);
            return;
        }
        
        if (msg.type === "permissions_update") {
            if (!clientInfo || !clientInfo.isHost || clientInfo.isTester) return;
            const targetUserId = Number(msg.targetUserId);
            if (!Number.isSafeInteger(targetUserId) || targetUserId <= 0 || targetUserId === clientInfo.userId) return;
            const permissions = normalizePermissions(msg.permissions);
            room.permissions[targetUserId] = permissions;
            for (const info of room.clients.values()) if (info.userId === targetUserId) info.permissions = permissions;
            if (room.persistent) schedulePersist();
            sendPlayers(room);
            return;
        }

        if (msg.type === "lock_request") {
            if (!clientInfo || clientInfo.isTester || typeof msg.objectId !== "string" || !msg.objectId || msg.objectId.length > 128) return;
            if (!room.locks) room.locks = new Map();
            const objectId = msg.objectId;
            const current = room.locks.get(objectId);
            const currentTime = Date.now();
            if (current && current.expiresAt > currentTime && current.userId !== clientInfo.userId) {
                try { ws.send(JSON.stringify({type:"lock_conflict", objectId, userId:current.userId, userName:current.userName, expiresAt:current.expiresAt})); } catch (_) {}
                return;
            }
            const lock = {userId:clientInfo.userId, userName:clientInfo.userName, expiresAt:currentTime + 90000};
            room.locks.set(objectId, lock);
            broadcast(room, {type:"lock_state", objectId, lock});
            return;
        }
        if (msg.type === "lock_release") {
            if (!clientInfo || typeof msg.objectId !== "string") return;
            const lock = room.locks?.get(msg.objectId);
            if (lock && (lock.userId === clientInfo.userId || clientInfo.isHost)) {
                room.locks.delete(msg.objectId);
                broadcast(room, {type:"lock_state", objectId:msg.objectId, lock:null});
            }
            return;
        }
        if (msg.type === "heartbeat") {
            if (!clientInfo) return;
            if (clientInfo.isHost) room.lastHostPing = Date.now();
            try { ws.send(JSON.stringify({type:"heartbeat_ack", ts:Date.now()})); } catch(e){} 
            return; 
        }
        
        if (msg.type === "chat") {
            if (!clientInfo) return;
            const chatNow = Date.now();
            if (chatNow - clientInfo.chatWindow.startedAt >= 10000) clientInfo.chatWindow = {startedAt: chatNow, count: 0};
            clientInfo.chatWindow.count++;
            if (clientInfo.chatWindow.count > CHAT_MESSAGES_PER_10S) return;
            const text = String(msg.text || "").replace(/[\x00-\x1F]/g, "").trim().slice(0, 1000);
            if (!text) return;
            broadcast(room, {type:"chat", userId:clientInfo.userId, userName:clientInfo.userName, text, ts:chatNow}, null);
            return;
        }
        
        if (msg.type === "kick") {
            // Защита: кикать может только хост
            if (!clientInfo || !myIsHost || myIsTester) return;
            const target = Number(msg.targetUserId);
            for (const [client, info] of room.clients) {
                if (info.userId === target) {
                    try { client.send(JSON.stringify({type:"kicked"})); } catch(e){}
                    try { client.close(); } catch(e){}
                    room.clients.delete(client);
                }
            }
            sendPlayers(room);
            return;
        }
        
        if (msg.type === "leave") {
            const wasHost = clientInfo && clientInfo.isHost;
            room.clients.delete(ws);
            
            if (wasHost && !room.persistent) {
                broadcast(room, {type:"host_left"});
                setTimeout(() => {
                    for (const [c] of room.clients) { 
                        try { c.send(JSON.stringify({type:"host_left"})); c.close(); } catch(e){} 
                    }
                    room.clients.clear();
                    rooms.delete(lobbyId);
                }, 1000);
            }
            sendPlayers(room);
            try { ws.close(); } catch(e){}
            return;
        }
    });
    
    ws.on("close", () => {
        if (lobbyId) {
            const room = rooms.get(lobbyId);
            if (room) {
                const info = room.clients.get(ws);
                const wasHost = info && info.isHost;
                room.clients.delete(ws);
                if (info && room.locks) {
                    for (const [objectId, lock] of room.locks.entries()) {
                        if (lock.userId === info.userId) {
                            room.locks.delete(objectId);
                            broadcast(room, {type:"lock_state", objectId, lock:null});
                        }
                    }
                }
                
                if (wasHost && room.clients.size > 0 && !room.persistent) {
                    broadcast(room, {type:"host_left"});
                    setTimeout(() => {
                        for (const [c] of room.clients) { 
                            try { c.send(JSON.stringify({type:"host_left"})); c.close(); } catch(e){} 
                        }
                        room.clients.clear();
                        rooms.delete(lobbyId);
                    }, 1000);
                }
                
                sendPlayers(room);
                if (room.clients.size === 0) {
                    setTimeout(() => { 
                        const r = rooms.get(lobbyId); 
                        if (r && r.clients.size === 0 && !r.persistent) rooms.delete(lobbyId); 
                    }, 60000);
                }
            }
        }
    });
});

const backupTimer = setInterval(() => {
    const currentTime = Date.now();
    for (const room of rooms.values()) {
        const settings = room.backupSettings;
        if (!room.persistent || !settings?.enabled || !room.snapshot.length) continue;
        if (currentTime - Number(settings.lastBackupAt || 0) < Number(settings.intervalMs || 86400000)) continue;
        const backup = {id:crypto.randomUUID(), createdAt:currentTime, reason:"automatic", snapshot:room.snapshot, history:room.history.slice(-MAX_HISTORY), snapshotSize:room.snapshot.length};
        room.backups = [...(room.backups || []), backup].slice(-(settings.retention || 20));
        settings.lastBackupAt = currentTime;
        schedulePersist();
    }
}, 60000);

const healthTimer = setInterval(() => {
    const url = HOST_PUBLIC_URL ? HOST_PUBLIC_URL + "/health" : `http://localhost:${PORT}/health`;
    fetch(url).catch(()=>{});
}, 10000);

async function shutdown(signal) {
    console.log(`[Shutdown] ${signal}: flushing persistent rooms...`);
    clearInterval(cleanupTimer);
    clearInterval(healthTimer);
    clearInterval(backupTimer);
    try { await flushPersistentRooms(); }
    catch (e) { console.error("[Shutdown] persistence flush failed:", e.message); process.exitCode = 1; }
    for (const ws of wss.clients) { try { ws.close(1001, "server shutting down"); } catch (_) {} }
    wss.close();
    server.close(() => process.exit(process.exitCode || 0));
    setTimeout(() => { server.closeAllConnections?.(); process.exit(process.exitCode || 0); }, 1500).unref();
}
process.once("SIGINT", () => shutdown("SIGINT"));
process.once("SIGTERM", () => shutdown("SIGTERM"));
restorePersistentRooms().then(() => server.listen(PORT, () => console.log(`[CollabSync Host] listening ${PORT}`))).catch(err => { console.error("[Persistence] Server 2 startup failed:", err); process.exit(1); });
