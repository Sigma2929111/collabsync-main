# Copy to .env and replace both values with independent random secrets (32+ characters).
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_SECRET=replace-with-another-random-secret-at-least-32-characters

# Comma-separated numeric Roblox UserIds that are test-only participants.
TESTER_IDS=

# Server 1 / combined server
PORT=3000
CATALOG_PUBLIC_URL=
PUBLIC_URL=

# Separate Server 2 (use PORT=3001 and the same JWT_SECRET as Server 1)
# HOST_PUBLIC_URL=
