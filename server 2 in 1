const PORT             = process.env.PORT || 3000;
const JWT_SECRET       = process.env.JWT_SECRET || "";
const ADMIN_SECRET     = process.env.ADMIN_SECRET || "";
if (JWT_SECRET.length < 32) throw new Error("JWT_SECRET must be set and contain at least 32 characters");
if (ADMIN_SECRET.length < 32) throw new Error("ADMIN_SECRET must be set and contain at least 32 characters");
const PUBLIC_URL       = (process.env.PUBLIC_URL || "").replace(/\/+$/, ""); 

const HEARTBEAT_TIMEOUT_MS = 45000;
const CHUNK_SIZE       = 200;
const CHUNK_DELAY_MS   = 60;
const MAX_HISTORY      = 8000;
const MAX_ROOM_CLIENTS = 32;
const WS_MESSAGES_PER_10S = 180;
const CHAT_MESSAGES_PER_10S = 6;
const ALLOWED_DELTA_KINDS = new Set(["create", "update", "delete", "select", "camera"]);

const TESTER_IDS   = new Set((process.env.TESTER_IDS || "").split(",").map(s=>s.trim()).filter(Boolean));

const lobbies       = new Map();
const rooms = new Map();
const DATA_DIR = process.env.COLLABSYNC_DATA_DIR || path.join(__dirname, ".collabsync-data");
const STATE_FILE = path.join(DATA_DIR, "state.json");
let persistTimer = null, persistQueue = Promise.resolve();
async function flushPersistentState() {
    if (persistTimer) { clearTimeout(persistTimer); persistTimer = null; }
    const keep = [...lobbies.values()].filter(l => l.persistent);
    const ids = new Set(keep.map(l => l.id));
    const state = { version: 1, lobbies: keep, rooms: [...rooms.entries()].filter(([id]) => ids.has(id)).map(([id, r]) => [id, { snapshot: r.snapshot, history: r.history, hostUserId: r.hostUserId, lastHostPing: r.lastHostPing, permissions: r.permissions }]) };
    const data = JSON.stringify(state);
    persistQueue = persistQueue.catch(() => {}).then(async () => {
        await fs.promises.mkdir(DATA_DIR, { recursive: true });
        const tmp = STATE_FILE + ".tmp";
        await fs.promises.writeFile(tmp, data, { mode: 0o600 });
        await fs.promises.rename(tmp, STATE_FILE);
    });
    await persistQueue;
}
function schedulePersist() {
    if (persistTimer) clearTimeout(persistTimer);
    persistTimer = setTimeout(() => {
        persistTimer = null;
        flushPersistentState().catch(e => console.error("[Persistence] save failed:", e.message));
    }, 250);
}
async function restorePersistentState() {
    try {
        const state = JSON.parse(await fs.promises.readFile(STATE_FILE, "utf8"));
        if (state.version !== 1 || !Array.isArray(state.lobbies) || !Array.isArray(state.rooms)) throw new Error("unsupported state format");
        for (const l of state.lobbies) if (l && typeof l.id === "string" && l.persistent) lobbies.set(l.id, l);
        for (const [id, saved] of state.rooms) if (lobbies.has(id) && saved && Array.isArray(saved.snapshot) && Array.isArray(saved.history)) rooms.set(id, { clients: new Map(), snapshot: saved.snapshot, history: saved.history.slice(-MAX_HISTORY), hostUserId: saved.hostUserId || null, lastHostPing: saved.lastHostPing || now(), permissions: saved.permissions && typeof saved.permissions === "object" ? saved.permissions : {} });
        console.log(`[Persistence] restored ${lobbies.size} persistent workspaces`);
    } catch (e) { if (e.code !== "ENOENT") console.error("[Persistence] restore failed:", e.message); }
}
const bannedUsers   = new Set();
const rateLimit     = new Map();

function now() { return Date.now(); }
function getUserRoles(userId, userName) {
    const idStr = String(userId || "");
    return {
        isTester: TESTER_IDS.has(idStr),
        isBanned: bannedUsers.has(idStr),
    };
}

