app.get("/network-info", (req, res) => {
    if (!isLoopbackRequest(req)) return res.status(403).end();
    const adapter = detectRadminIPv4();
    res.set("Cache-Control", "no-store").json({ok:true, radminIp:adapter?.address || null, adapter:adapter?.name || null, port:Number(PORT)});
});
app.use((req, res, next) => {
    res.header("Access-Control-Allow-Origin", "*");
    res.header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Admin-Key");
    res.header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS");
    if (req.method === "OPTIONS") return res.sendStatus(204);
    next();
});
app.use((req, res, next) => {
    if (req.path === "/health" || !req.path.startsWith("/api/")) return next();
    const ip = req.ip || "unknown";
    const key = ip + ":" + req.path;
    const t = now();
    let entry = rateLimit.get(key);
    if (!entry || t > entry.reset) { entry = { count: 0, reset: t + 60000 }; rateLimit.set(key, entry); }
    entry.count++;
    if (entry.count > 120) return res.status(429).json({ error: "rate limited" });
    next();
});

app.get("/health", (req, res) => res.json({ ok: true, ts: now(), lobbies: lobbies.size, rooms: rooms.size }));

app.post("/api/lobby/create", async (req, res) => {
    try {
        const { name, hostId, hostName, password, isPrivate, placeId, placeName } = req.body || {};
        const hostUid = Number(hostId);
        if (!name || !Number.isSafeInteger(hostUid) || hostUid <= 0) return res.status(400).json({ error: "valid name and hostId required" });
        if (String(name).length > 100) return res.status(400).json({ error: "name too long" });

        const roles = getUserRoles(hostUid, hostName);
        if (roles.isBanned) return res.status(403).json({ error: "banned" });
        if (roles.isTester) return res.status(403).json({ error: "testers are read-only and cannot host edit lobbies" });

        const lobbyId = crypto.randomUUID();
        const passwordHash = password ? await bcrypt.hash(String(password), 10) : null;
        const hostUrl = PUBLIC_URL || `${req.protocol}://${req.get("host")}`;

        lobbies.set(lobbyId, {
            id: lobbyId, name: String(name),
            hostId: hostUid, hostName: String(hostName || hostUid).slice(0, 32),
            passwordHash, isPrivate: !!isPrivate,
            hostUrl, placeId: placeId || null, placeName: placeName || null,
            createdAt: now(), lastPing: now(), persistent: req.body?.persistent === true,
            backupSettings: { enabled: false, intervalMs: 86400000, retention: 20 }, backups: [], activity: [],
        });
        schedulePersist();

        const token = jwt.sign(
            { lobbyId, userId: hostUid, userName: String(hostName || hostUid).slice(0, 32), isHost: true, isTester: false, lobbyName: String(name) },
            JWT_SECRET, { expiresIn: "12h" }
        );
        res.json({ lobbyId, token, hostUrl, persistent: lobbies.get(lobbyId)?.persistent === true });
    } catch (e) { res.status(500).json({ error: String(e) }); }
});

app.post("/api/lobby/join", async (req, res) => {
    const { lobbyId, userId, userName, password } = req.body || {};
    const uid = Number(userId);
    if (!lobbyId || !Number.isSafeInteger(uid) || uid <= 0) return res.status(400).json({ error: "valid lobbyId and userId required" });
    const lobby = lobbies.get(lobbyId);
    if (!lobby) return res.status(404).json({ error: "lobby not found" });

    const safeName = String(userName || uid).slice(0, 32);
    const roles = getUserRoles(uid, safeName);
    if (roles.isBanned) return res.status(403).json({ error: "banned" });

    if (lobby.passwordHash) {
        if (!password) return res.status(401).json({ error: "password required" });
        const ok = await bcrypt.compare(String(password), lobby.passwordHash);
        if (!ok) return res.status(403).json({ error: "invalid password" });
    }
    if (!lobby.persistent && now() - lobby.lastPing > HEARTBEAT_TIMEOUT_MS) {
        lobbies.delete(lobbyId);
        return res.status(410).json({ error: "lobby expired" });
    }

    const joiningAsHost = uid === lobby.hostId;
    const token = jwt.sign(
        { lobbyId, userId: uid, userName: safeName, isHost: joiningAsHost, isTester: joiningAsHost ? false : roles.isTester, lobbyName: lobby.name },
        JWT_SECRET, { expiresIn: "12h" }
    );
    res.json({
        token, hostUrl: PUBLIC_URL || `${req.protocol}://${req.get("host")}`,
        lobbyId, lobbyName: lobby.name, hostName: lobby.hostName, hostId: lobby.hostId,
        isHost: joiningAsHost, persistent: lobby.persistent === true
    });
});

app.get("/api/lobby/list", (req, res) => {
    const t = now();
    const list = [];
    for (const l of lobbies.values()) {
        if (l.isPrivate) continue;
        if (!l.persistent && t - l.lastPing > HEARTBEAT_TIMEOUT_MS) continue;
        list.push({
            id: l.id, name: l.name, hostName: l.hostName, hostId: l.hostId,
            hasPassword: !!l.passwordHash, placeName: l.placeName, placeId: l.placeId,
            hostUrl: l.hostUrl, createdAt: l.createdAt,
        });
    }
    list.sort((a, b) => b.createdAt - a.createdAt);
    res.json({ lobbies: list });
});

app.post("/api/lobby/heartbeat", (req, res) => {
    const { lobbyId } = req.body || {};
    const lobby = lobbies.get(lobbyId);
    if (!lobby) return res.status(404).json({ error: "not found" });
    const auth = String(req.headers.authorization || "");
    const token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    let decoded;
    try { decoded = jwt.verify(token, JWT_SECRET); } catch (_) {
        return res.status(401).json({ error: "unauthorized" });
    }
    if (!decoded.isHost || decoded.lobbyId !== lobbyId || Number(decoded.userId) !== lobby.hostId) {
        return res.status(403).json({ error: "forbidden" });
    }
    lobby.lastPing = now();
    schedulePersist();
    res.json({ ok: true });
});

app.post("/api/lobby/delete", (req, res) => {
    const { lobbyId } = req.body || {};
    const lobby = lobbies.get(lobbyId);
    if (!lobby) return res.status(404).json({ error: "not found" });
    const auth = String(req.headers.authorization || "");
    const token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    let decoded;
    try { decoded = jwt.verify(token, JWT_SECRET); } catch (_) {
        return res.status(401).json({ error: "unauthorized" });
    }
    if (!decoded.isHost || decoded.lobbyId !== lobbyId || Number(decoded.userId) !== lobby.hostId) {
        return res.status(403).json({ error: "forbidden" });
    }
    lobbies.delete(lobbyId); rooms.delete(lobbyId); schedulePersist();
    res.json({ ok: true });
});

function ownerForWorkspace(req, res) {
    const auth = String(req.headers.authorization || ""), token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    try {
        const claims = jwt.verify(token, JWT_SECRET), id = String(req.params.lobbyId || req.body?.lobbyId || "");
        const lobby = lobbies.get(id);
        if (!lobby) { res.status(404).json({ error: "workspace not found" }); return null; }
        if (!claims.isHost || claims.lobbyId !== id || Number(claims.userId) !== lobby.hostId) { res.status(403).json({ error: "owner required" }); return null; }
        return lobby;
    } catch (_) { res.status(401).json({ error: "unauthorized" }); return null; }
}
app.get("/api/workspace/:lobbyId/activity", (req, res) => {
    const l = ownerForWorkspace(req, res); if (!l) return;
    if (!l.persistent) return res.status(409).json({ error: "activity log is available for persistent workspaces only" });
    res.json({ activity: (l.activity || []).slice(-50) });
});
app.get("/api/workspace/:lobbyId/backups", (req, res) => {
    const l = ownerForWorkspace(req, res); if (!l) return;
    res.json({ settings: l.backupSettings, backups: (l.backups || []).map(({id, createdAt, reason, snapshotSize}) => ({id, createdAt, reason, snapshotSize})) });
});
app.post("/api/workspace/backups/settings", (req, res) => {
    const l = ownerForWorkspace(req, res); if (!l) return;
    const intervalMs = Number(req.body?.intervalMs || 86400000), retention = Number(req.body?.retention || 20);
    if (!Number.isSafeInteger(intervalMs) || intervalMs < 3600000 || intervalMs > 2592000000 || !Number.isInteger(retention) || retention < 1 || retention > 100) return res.status(400).json({ error: "invalid backup settings" });
    l.backupSettings = { enabled: req.body?.enabled === true, intervalMs, retention, lastBackupAt: l.backupSettings?.lastBackupAt || 0 }; schedulePersist();
    res.json({ ok: true, settings: l.backupSettings });
});
app.post("/api/workspace/backups/create", (req, res) => {
    const l = ownerForWorkspace(req, res); if (!l) return;
    const room = rooms.get(l.id); if (!room || !room.snapshot.length) return res.status(409).json({ error: "no snapshot available" });
    const b = { id: crypto.randomUUID(), createdAt: now(), reason: "manual", snapshot: room.snapshot, history: room.history.slice(-MAX_HISTORY), snapshotSize: room.snapshot.length };
    l.backups = [...(l.backups || []), b].slice(-(l.backupSettings?.retention || 20)); l.backupSettings.lastBackupAt = now(); schedulePersist();
    res.json({ ok: true, backup: { id: b.id, createdAt: b.createdAt, snapshotSize: b.snapshotSize } });
});
app.post("/api/workspace/backups/restore", (req, res) => {
    const l = ownerForWorkspace(req, res); if (!l) return;
    const room = rooms.get(l.id), b = (l.backups || []).find(x => x.id === req.body?.backupId);
    if (!room || !b) return res.status(404).json({ error: "backup not found" });
    if (room.snapshot.length) { const safe = { id: crypto.randomUUID(), createdAt: now(), reason: "pre-restore", snapshot: room.snapshot, history: room.history, snapshotSize: room.snapshot.length }; l.backups = [...(l.backups || []), safe].slice(-(l.backupSettings?.retention || 20)); }
    room.snapshot = b.snapshot; room.history = b.history || []; schedulePersist();
    res.json({ ok: true, restoredBackupId: b.id, snapshotSize: room.snapshot.length, note: "Reconnect the Studio plugin to load the restored snapshot." });
});

