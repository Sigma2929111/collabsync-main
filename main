I("UIListLayout", {Padding=UDim.new(0,8)}, wlList)

local function userRow(uid, name, isHostRow)
    local r = I("Frame", {Size=UDim2.new(1,0,0,40), BackgroundColor3=T.surf2, BorderSizePixel=0}, wlList)
    round(r, 8); r:SetAttribute("uid", uid)
    avatar(r, 28, uid).Position = UDim2.fromOffset(6,6)
    local nLbl = lbl(r, formatName(uid), {textSize=13, size=UDim2.new(1,-180,1,0), pos=UDim2.fromOffset(44,0)})
    applyNameStyle(nLbl, uid)
    if isHostRow then
        lbl(r, "👑", {font=Enum.Font.GothamBold, textSize=16, color=T.gold, xAlign=Enum.TextXAlignment.Center, size=UDim2.fromOffset(30,26), pos=UDim2.new(1,-100,0.5,-13)})
        return
    end
    local delBtn = btn(r, "Удалить", {size=UDim2.fromOffset(90,26), pos=UDim2.new(1,-100,0.5,-13), bg=T.surface, hoverBg=T.danger, textSize=11})
    delBtn.MouseButton1Click:Connect(function()
        local scope = currentWhitelistScope
        if not scope or not scope.whitelist then return end
        for i, u in ipairs(scope.whitelist) do if u == uid then table.remove(scope.whitelist, i); break end end
        r:Destroy()
    end)
end

refreshWhitelist = function()
    for _, ch in ipairs(wlList:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
    local scope = currentWhitelistScope
    if not scope or not scope.whitelist then return end
    local hostUid = scope.hostId or MY_ID
    for _, uid in ipairs(scope.whitelist) do userRow(uid, formatName(uid), uid == hostUid) end
end

-- Autocomplete dropdown
local searchPreview = I("Frame", {Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,1,-56), BackgroundColor3=T.surf2, BorderSizePixel=0, Visible=false, ZIndex=10}, SPlace)
round(searchPreview, 8); outline(searchPreview, T.accent, 1)
local spLayout = I("UIListLayout", {Padding=UDim.new(0,0)}, searchPreview)

local addRow = I("Frame", {Size=UDim2.new(1,0,0,44), Position=UDim2.new(0,0,1,-50), BackgroundColor3=T.surface, BorderSizePixel=0}, SPlace)
round(addRow, 8); outline(addRow, T.border, 1); pad(addRow, 6, 10)
local addBox = I("TextBox", {Size=UDim2.new(1,-140,1,0), BackgroundTransparency=1, BorderSizePixel=0, Font=Enum.Font.Gotham, TextSize=13, TextColor3=T.text, PlaceholderText="ID или ник", PlaceholderColor3=T.muted, Text="", TextXAlignment=Enum.TextXAlignment.Left}, addRow)
local addBtn = btn(addRow, "Добавить", {size=UDim2.fromOffset(120,32), pos=UDim2.new(1,-120,0.5,-16), bg=T.accent, hoverBg=T.accent2, textSize=12})

local currentSuggestUid = nil
local currentSuggestName = nil
local searchDebounce = tick()

addBox:GetPropertyChangedSignal("Text"):Connect(function()
    searchDebounce = tick()
    local txt = addBox.Text
    local myStamp = searchDebounce
    currentSuggestUid = nil
    currentSuggestName = nil
    
    if txt == "" then searchPreview.Visible = false; return end
    
    task.delay(0.4, function()
        if myStamp ~= searchDebounce then return end
        local uid = tonumber(txt)
        local info = nil
        
        if uid then
            info = {uid=uid, name=resolveName(uid)}
        else
            local ok, result = pcall(function() return Players:GetUserIdFromNameAsync(txt) end)
            if ok and result then info = {uid=result, name=txt} end
        end
        
        for _, ch in ipairs(searchPreview:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
        searchPreview.Visible = true
        
        if info then
            currentSuggestUid = info.uid
            currentSuggestName = info.name
            local row = I("Frame", {Size=UDim2.new(1,0,0,40), BackgroundTransparency=1}, searchPreview)
            avatar(row, 28, info.uid).Position = UDim2.fromOffset(6,6)
            local n = lbl(row, info.name.."  (ID: "..info.uid..")", {textSize=13, size=UDim2.new(1,-60,1,0), pos=UDim2.fromOffset(44,0)})
            applyNameStyle(n, info.uid)
            local cb = I("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", ZIndex=11}, row)
            cb.MouseButton1Click:Connect(function()
                addBox.Text = tostring(info.uid)
            end)
        else
            local row = I("Frame", {Size=UDim2.new(1,0,0,40), BackgroundTransparency=1}, searchPreview)
            lbl(row, "Не найден: "..txt, {textSize=13, color=T.danger, size=UDim2.new(1,-10,1,0), pos=UDim2.fromOffset(10,0)})
        end
        searchPreview.Size = UDim2.new(1, 0, 0, 40)
    end)
end)

addBtn.MouseButton1Click:Connect(function()
    local scope = currentWhitelistScope
    if not scope or not scope.whitelist then return end
    local txt = addBox.Text
    if txt == "" then return end
    
    local uid = currentSuggestUid
    local name = currentSuggestName
    if not uid then
        local n = tonumber(txt)
        if n then uid = n; name = resolveName(n) else
            local ok, r = pcall(function() return Players:GetUserIdFromNameAsync(txt) end)
            if ok and r then uid = r; name = txt end
        end
    end
    
    if not uid then showToast(S, "Пользователь не найден", T.danger); return end
    for _, u in ipairs(scope.whitelist) do if u == uid then showToast(S, "Уже в списке", T.warn); return end end
    
    table.insert(scope.whitelist, uid)
    refreshWhitelist()
    addBox.Text = ""
    searchPreview.Visible = false
    currentSuggestUid = nil
    currentSuggestName = nil
end)

-- Perms
lbl(SPerms, "Права участников", {font=Enum.Font.GothamBold, textSize=16, size=UDim2.new(1,0,0,24)})
local permsBody = I("Frame", {Size=UDim2.new(1,0,1,-130), Position=UDim2.fromOffset(0,54), BackgroundColor3=T.surface, BorderSizePixel=0}, SPerms)
round(permsBody, 10); outline(permsBody, T.border, 1); pad(permsBody, 10)
local permList = I("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1}, permsBody)
I("UIListLayout", {Padding=UDim.new(0,8)}, permList)

local permNames = {"Редакт.", "Удалять", "Двигать", "Добавлять"}
local permRow = function(uid, name, defaults, isHostRow)
    local r = I("Frame", {Size=UDim2.new(1,0,0,52), BackgroundColor3=T.surf2, BorderSizePixel=0}, permList)
    round(r, 8)
    avatar(r, 28, uid).Position = UDim2.fromOffset(6,12)
    local nLbl = lbl(r, formatName(uid), {textSize=13, size=UDim2.new(1,-360,1,0), pos=UDim2.fromOffset(44,0), truncate=true})
    applyNameStyle(nLbl, uid)
    
    if isHostRow then
        lbl(r, "👑", {font=Enum.Font.GothamBold, textSize=16, color=T.gold, xAlign=Enum.TextXAlignment.Left, size=UDim2.fromOffset(28,26), pos=UDim2.new(1,-360,0.5,-13)})
    elseif isOwnLobby and uid ~= MY_ID then
        local kickBtn = btn(r, "Кикнуть", {size=UDim2.fromOffset(78,24), pos=UDim2.new(1,-360,0.5,-12), bg=T.surface, hoverBg=T.danger, textSize=11})
        kickBtn.MouseButton1Click:Connect(function() kickPlayer(uid) end)
    end
    
    local cbox = I("Frame", {Size=UDim2.new(0,270,1,0), Position=UDim2.new(1,-270,0,0), BackgroundTransparency=1}, r)
    I("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), VerticalAlignment=Enum.VerticalAlignment.Center, HorizontalAlignment=Enum.HorizontalAlignment.Right}, cbox)
    
    for i, pname in ipairs(permNames) do
        local on = (defaults and defaults[i]) or false
        local chip = I("Frame", {Size=UDim2.fromOffset(62,26), BackgroundColor3=on and T.success or T.surf3, BorderSizePixel=0}, cbox)
        round(chip, 6)
        lbl(chip, pname, {textSize=10, xAlign=Enum.TextXAlignment.Center, color=on and Color3.new(1,1,1) or T.muted, size=UDim2.fromScale(1,1)})
        local cb = I("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", ZIndex=5}, chip)
        local isOn = on
        cb.MouseButton1Click:Connect(function()
            isOn = not isOn
            chip.BackgroundColor3 = isOn and T.success or T.surf3
            chip:FindFirstChildOfClass("TextLabel").TextColor3 = isOn and Color3.new(1,1,1) or T.muted
        end)
    end
end

refreshPerms = function()
    for _, ch in ipairs(permList:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
    if not State.session then return end
    local players = State.remotePlayers
    if #players == 0 then players = {{userId=MY_ID, userName=MY_NAME, isHost=isOwnLobby, roles=MY_ROLES}} end
    for _, p in ipairs(players) do
        local isHostRow = p.isHost or (currentLobby and currentLobby.hostId == p.userId)
        permRow(p.userId, formatName(p.userId), {true, true, true, true}, isHostRow)
    end
end

