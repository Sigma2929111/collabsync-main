round(blInputRow, 8); outline(blInputRow, T.border, 1); pad(blInputRow, 6, 10)
local blBox = I("TextBox", {Size=UDim2.new(1,-140,1,0), BackgroundTransparency=1, BorderSizePixel=0, Font=Enum.Font.Gotham, TextSize=13, TextColor3=T.text, PlaceholderText="ID или ник", PlaceholderColor3=T.muted, Text="", TextXAlignment=Enum.TextXAlignment.Left}, blInputRow)
local blAddBtn = btn(blInputRow, "Забанить", {size=UDim2.fromOffset(120,32), pos=UDim2.new(1,-120,0.5,-16), bg=T.danger, hoverBg=Color3.fromRGB(255,120,120), textSize=12})

local function rebuildBlacklistUI()
    for _, ch in ipairs(blList:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
    for key, val in pairs(State.blacklist) do
        if val then
            local r = I("Frame", {Size=UDim2.new(1,0,0,36), BackgroundColor3=T.surf2, BorderSizePixel=0}, blList)
            round(r, 6)
            lbl(r, key, {textSize=13, size=UDim2.new(1,-100,1,0), pos=UDim2.fromOffset(10,0)})
            local delBtn = btn(r, "Удалить", {size=UDim2.fromOffset(80,26), pos=UDim2.new(1,-90,0.5,-13), bg=T.surface, hoverBg=T.danger, textSize=11})
            delBtn.MouseButton1Click:Connect(function()
                State.blacklist[key] = nil
                saveBlacklist()
                rebuildBlacklistUI()
            end)
        end
    end
end

blAddBtn.MouseButton1Click:Connect(function()
    local txt = blBox.Text
    if txt == "" then return end
    State.blacklist[txt] = true
    saveBlacklist()
    blBox.Text = ""
    rebuildBlacklistUI()
end)

local function switchSTab(which)
    SGui.Visible = (which == "gui"); SPlace.Visible = (which == "place"); SPerms.Visible = (which == "perms"); SBlack.Visible = (which == "black")
    sTabGui.BackgroundColor3 = (which == "gui") and T.accent or T.surface
    sTabPlace.BackgroundColor3 = (which == "place") and T.accent or T.surface
    sTabPerms.BackgroundColor3 = (which == "perms") and T.accent or T.surface
    sTabBlack.BackgroundColor3 = (which == "black") and T.accent or T.surface
end

sTabGui.MouseButton1Click:Connect(function() switchSTab("gui") end)
sTabPlace.MouseButton1Click:Connect(function() refreshWhitelist(); switchSTab("place") end)
sTabPerms.MouseButton1Click:Connect(function() refreshPerms(); switchSTab("perms") end)
sTabBlack.MouseButton1Click:Connect(function() rebuildBlacklistUI(); switchSTab("black") end)

local openSettings = function(context)
    previousScreen = lastVisibleFrame
    Main.Visible = false; InPlace.Visible = false; S.Visible = true
    lastVisibleFrame = S
    if context == "main" then currentWhitelistScope = State.myPlace
    elseif context == "inplace" and isOwnLobby and currentLobby then currentWhitelistScope = currentLobby
    else currentWhitelistScope = nil end
    
    local isOwnerRole = MY_ROLES and MY_ROLES.isOwner
    sTabPlace.Visible = (currentWhitelistScope ~= nil)
    sTabPerms.Visible = (context == "inplace" and isOwnLobby)
    sTabBlack.Visible = isOwnerRole
    switchSTab("gui")
end
settingsBtn.MouseButton1Click:Connect(function() openSettings("main") end)

