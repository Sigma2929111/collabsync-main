local LFilter = lbl(LogsWindow, "", {textSize=11, color=T.muted, size=UDim2.new(1,-40,0,16), pos=UDim2.fromOffset(20,58)})
local LScroll = I("ScrollingFrame", {Size=UDim2.new(1,-40,1,-100), Position=UDim2.fromOffset(20,80), BackgroundColor3=T.surface, BorderSizePixel=0, CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y, ScrollBarThickness=6, ScrollBarImageColor3=T.border}, LogsWindow)
round(LScroll, 8); outline(LScroll, T.border, 1); pad(LScroll, 8)
local LList = I("Frame", {Size=UDim2.new(1,0,0,0), AutomaticSize=Enum.AutomaticSize.Y, BackgroundTransparency=1}, LScroll)
I("UIListLayout", {Padding=UDim.new(0,2)}, LList)

local function refreshLogsUI()
    if not LogsWindow or not LogsWindow.Visible then return end
    for _, ch in ipairs(LList:GetChildren()) do if ch:IsA("TextLabel") then ch:Destroy() end end
    local inLobby = State.session ~= nil
    LFilter.Text = inLobby and "Режим: Лобби" or "Режим: Плагин"
    local count = 0
    for _, entry in ipairs(State.logs) do
        if inLobby or entry.scope == "plugin" then
            count = count + 1
            local color = T.text
            local prefix = ""
            if entry.level == "error" then color = T.danger; prefix = "[ERR] "
            elseif entry.level == "warn" then color = T.warn; prefix = "[WRN] "
            elseif entry.level == "action" then color = T.accent; prefix = "[ACT] "
            elseif entry.level == "success" then color = T.success; prefix = "[OK] " end
            I("TextLabel", {Size=UDim2.new(1,0,0,18), BackgroundTransparency=1, Font=Enum.Font.Code, TextSize=11, TextColor3=color, TextXAlignment=Enum.TextXAlignment.Left, Text=entry.time.."  "..prefix..entry.text}, LList)
        end
    end
    if count == 0 then lbl(LList, "Пусто.", {textSize=12, color=T.muted, size=UDim2.new(1,0,0,20)}) end
    task.defer(function() task.wait(0.05); if LScroll then LScroll.CanvasPosition = Vector2.new(0, math.max(0, LScroll.AbsoluteCanvasSize.Y - LScroll.AbsoluteWindowSize.Y)) end end)
end
_G.__collabsync_update_logs = refreshLogsUI

local function toggleLogs()
    if not LogsWindow then return end
    LogsWindow.Visible = not LogsWindow.Visible
    if LogsWindow.Visible then refreshLogsUI() end
end
logsBtn.MouseButton1Click:Connect(toggleLogs)
lClearBtn.MouseButton1Click:Connect(function() State.logs = {}; refreshLogsUI() end)
lCopyBtn.MouseButton1Click:Connect(function()
    local inLobby = State.session ~= nil
    local text = "=== CollabSync ===\n"
    for _, entry in ipairs(State.logs) do
        if inLobby or entry.scope == "plugin" then text = text..entry.time.." ["..entry.level.."] "..entry.text.."\n" end
    end
    local ok = pcall(function() setclipboard(text) end)
    showToast(LogsWindow, ok and "Скопировано" or "Ошибка", ok and T.success or T.danger)
end)

--==================================================================
-- Refresh styles hook (called when server1 roles arrive)
--==================================================================
_G.__collabsync_refresh_styles = function()
    if meNameLbl and meNameLbl.Parent then
        pcall(function()
            meNameLbl.Text = formatName(MY_ID)
            meNameLbl.TextColor3 = nameColor(MY_ID)
        end)
    end
    for uid in pairs(State.localMarkers) do
        if refreshMarkerStyle then pcall(refreshMarkerStyle, uid) end
    end
    if refreshPlayerList then pcall(refreshPlayerList) end
end

