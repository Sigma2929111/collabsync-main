--==================================================================
-- WebSocket & Session
--==================================================================
connectWebSocket = function(hostUrl, token, isHost, onReady, onFail, isReconnect)
    if State.connecting then return end
    State.connecting = true
    if State.reconnectTask then pcall(task.cancel, State.reconnectTask); State.reconnectTask = nil end
    if State.wsClient then
        local old = State.wsClient; State.wsClient = nil
        pcall(function() old:Close() end)
        task.wait(0.1)
    end
    State.connected = false
    State.synced = false
    State.pendingChunks = {}
    State.isReconnect = isReconnect or false
    
    local wsUrl = hostUrl
    if wsUrl:match("^https://") then wsUrl = "wss://"..wsUrl:sub(9) end
    if wsUrl:match("^http://") then wsUrl = "ws://"..wsUrl:sub(8) end
    wsUrl = wsUrl:gsub("/+$", "")
    if not wsUrl:match("/ws$") then wsUrl = wsUrl.."/ws" end
    
    logMsg("plugin", "info", "WS: "..wsUrl..(isReconnect and " (reconnect)" or ""))
    
    local ok, client = pcall(function() return HttpService:CreateWebStreamClient(Enum.WebStreamClientType.WebSocket, {Url=wsUrl}) end)
    if not ok or not client then State.connecting = false; onFail("Ошибка WS: "..tostring(client)); return end
    
    State.wsClient = client
    local readyCalled = false
    local snapshotSent = false
    
    client.Opened:Connect(function()
        State.connecting = false
        State.connected = true
        pcall(function() client:Send(HttpService:JSONEncode({type="hello", token=token, userId=MY_ID, userName=MY_NAME})) end)
    end)
    
    client.MessageReceived:Connect(function(msg)
        local ok, data = pcall(function() return HttpService:JSONDecode(msg) end)
        if not ok or type(data) ~= "table" then return end
        
        if data.type == "welcome" then
            State.connected = true; State.lastAck = tick()
            State.remotePlayers = data.players or {}
            State.pendingChunks = {}
            State.synced = false
            pcall(refreshPlayerList)
            
            -- Send our roles (fetched from server1) so others see correct roles
            pcall(function() client:Send(HttpService:JSONEncode({type="roles", roles=MY_ROLES})) end)
            
            for uid in pairs(State.localMarkers) do if uid ~= MY_ID then destroyLocalMarker(uid) end end
            -- Markers are NOT created here. They'll be created after snapshot or timeout.
            
            if isHost and not snapshotSent then
                snapshotSent = true
                task.spawn(function()
                    local snap = buildSnapshot()
                    logMsg("lobby", "info", "Снапшот: "..#snap)
                    pcall(function() client:Send(HttpService:JSONEncode({type="snapshot", data=snap})) end)
                end)
            end
            
            -- If we're host, we can consider ourselves synced immediately (we built the snapshot)
            if isHost then
                State.synced = true
                task.defer(processPendingMarkers)
            else
                -- Guest: wait for snapshot_chunk or timeout
                task.delay(SYNC_TIMEOUT, function()
                    if State.connected and not State.synced then
                        logMsg("lobby", "warn", "Синк таймаут, помечаем как синхронизировано")
                        State.synced = true
                        processPendingMarkers()
                    end
                end)
            end
            
            task.delay(3, function()
                if State.connected and State.session then
                    local hostFound = false
                    for _, p in ipairs(State.remotePlayers) do if p.isHost then hostFound = true; break end end
                    if not hostFound then
                        logMsg("lobby", "warn", "Хост не найден, выход")
                        exitLobbyUI()
                    end
                end
            end)
            
            if not readyCalled then readyCalled = true; if onReady then pcall(onReady) end end
            
        elseif data.type == "snapshot_chunk" then
            table.insert(State.pendingChunks, {chunk=data.chunk, index=data.index or 0})
            local total = 0
            for _, c in ipairs(State.pendingChunks) do total = total + #c.chunk end
            if total >= (data.total or 0) then
                local allItems = {}
                table.sort(State.pendingChunks, function(a, b) return a.index < b.index end)
                for _, c in ipairs(State.pendingChunks) do
                    for _, item in ipairs(c.chunk) do table.insert(allItems, item) end
                end
                State.pendingChunks = {}
                task.spawn(function()
                    State.applyingSnapshot = true
                    local hostIds = {}
                    for i, item in ipairs(allItems) do
                        hostIds[item.id] = true
                        applyDelta({kind="create", id=item.id, parentId=item.parentId, className=item.className, name=item.name, props=item.props, attrs=item.attrs})
                        if i % APPLY_CHUNK == 0 then task.wait(APPLY_CHUNK_DELAY) end
                    end
                    task.wait(0.3)
                    local removed = 0
                    for id, inst in pairs(State.objectMap) do
                        if not hostIds[id] and inst and inst.Parent then
                            pcall(function() inst:Destroy() end)
                            State.objectMap[id] = nil
                            removed = removed + 1
                        end
                    end
                    logMsg("lobby", "info", "Снапшот: "..#allItems..", удалено: "..removed)
                    State.synced = true
                    task.delay(0.5, function() State.applyingSnapshot = false end)
                    processPendingMarkers()
                end)
            end
            
        elseif data.type == "history" then
            task.spawn(function()
                for _, delta in ipairs(data.data or {}) do
                    if delta.kind ~= "camera" then applyDelta(delta) end
                end
            end)
            
        elseif data.type == "delta" then
            applyDelta(data)
            
        elseif data.type == "chat" then
            addMessageToUI(data.userId, data.userName, data.text)
            logMsg("lobby", "info", "Чат: "..data.userName..": "..data.text)
            
        elseif data.type == "players" then
            State.remotePlayers = data.players or {}
            pcall(refreshPlayerList)
            local found = false
            for _, p in ipairs(State.remotePlayers) do if p.userId == MY_ID then found = true; break end end
            if not found and #State.remotePlayers > 0 then
                logMsg("lobby", "error", "Меня нет в списке")
                task.defer(function() exitLobbyUI() end)
                return
            end
            local active = {}
            for _, p in ipairs(State.remotePlayers) do
                active[p.userId] = true
                if p.roles then roleCache[p.userId] = p.roles end
            end
            for uid in pairs(State.localMarkers) do if not active[uid] then destroyLocalMarker(uid) end end
            -- Only create markers if synced
            if State.synced then
                for _, p in ipairs(State.remotePlayers) do
                    if p.userId ~= MY_ID and not State.localMarkers[p.userId] then
                        createLocalMarker(p.userId, p.userName)
                    end
                end
                for uid in pairs(State.localMarkers) do refreshMarkerStyle(uid) end
            end
            
        elseif data.type == "heartbeat_ack" then
            State.lastAck = tick()
            
        elseif data.type == "kicked" then
            logMsg("lobby", "warn", "Вас исключили")
            showToast(InPlace, "Вас исключили", T.danger)
            task.defer(function() exitLobbyUI() end)
            
        elseif data.type == "host_left" then
            logMsg("lobby", "warn", "Хост вышел, лобби закрыто")
            showToast(InPlace, "Хост вышел", T.danger)
            task.defer(function() exitLobbyUI() end)
            
        elseif data.type == "error" then
            logMsg("lobby", "error", data.message or "server error")
            if data.message and data.message:match("host") then
                showToast(InPlace, "Хост недоступен", T.danger)
                task.defer(function() exitLobbyUI() end)
            end
        end
    end)
    
    client.Closed:Connect(function()
        if State.wsClient ~= client then return end
        State.connected = false; State.connecting = false; State.synced = false
        logMsg("plugin", "warn", "WS закрыт")
        if settings.autoReconnect and State.session then
            if State.reconnectTask then pcall(task.cancel, State.reconnectTask) end
            State.reconnectTask = task.delay(RECONNECT_DELAY, function()
                State.reconnectTask = nil
                if State.session and not State.connecting then
                    connectWebSocket(State.session.hostUrl, State.session.token, State.session.isHost, function() end, function() end, true)
                end
            end)
        end
    end)
    
    client.Error:Connect(function(code, err)
        logMsg("plugin", "error", "WS: "..tostring(err))
        State.connecting = false
        if not readyCalled then readyCalled = true; pcall(onFail, "Ошибка: "..tostring(err)) end
    end)
    
    task.delay(WS_TIMEOUT, function()
        if State.connecting then
            State.connecting = false
            if not readyCalled then readyCalled = true; pcall(onFail, "Таймаут") end
        end
    end)
end

startHeartbeat = function()
    if State.heartbeatThread then task.cancel(State.heartbeatThread) end
    State.heartbeatThread = task.spawn(function()
        while State.session do
            if State.wsClient then pcall(function() State.wsClient:Send(HttpService:JSONEncode({type="heartbeat", userId=MY_ID})) end) end
            if State.session.lobbyId and State.session.lobbyId ~= "direct" then
                pcall(function() httpJson(CATALOG_URL.."/api/lobby/heartbeat", "POST", {lobbyId=State.session.lobbyId}) end)
            end
            task.wait(HEARTBEAT_INTERVAL)
        end
    end)
end

stopSession = function()
    if State.heartbeatThread then task.cancel(State.heartbeatThread); State.heartbeatThread = nil end
    if State.catalogPollThread then task.cancel(State.catalogPollThread); State.catalogPollThread = nil end
    if State.reconnectTask then pcall(task.cancel, State.reconnectTask); State.reconnectTask = nil end
    State.session = nil
    if State.wsClient then
        local old = State.wsClient; State.wsClient = nil
        pcall(function() old:Send(HttpService:JSONEncode({type="leave", userId=MY_ID})); old:Close() end)
    end
    State.connected = false; State.connecting = false; State.synced = false
    for uid in pairs(State.localMarkers) do destroyLocalMarker(uid) end
end

exitLobbyUI = function()
    if State.session and State.session.isHost then
        pcall(function() httpJson(CATALOG_URL.."/api/lobby/delete", "POST", {lobbyId=State.session.lobbyId, userId=MY_ID}) end)
    end
    stopSession()
    InPlace.Visible = false
    Main.Visible = true
    lastVisibleFrame = Main
    currentLobby = nil
    isOwnLobby = false
end

exitBtn.MouseButton1Click:Connect(function()
    if State.session then
        exitLobbyUI()
    else
        InPlace.Visible = false
        Main.Visible = true
        lastVisibleFrame = Main
    end
end)

--==================================================================
-- Catalog / Cards / Join / Publish
--==================================================================
card = function(placeName, lobbyName, players, opts)
    local c = I("Frame", {Size=UDim2.new(1,0,0,92), BackgroundColor3=T.surface, BorderSizePixel=0})
    round(c, 12); outline(c, T.border, 1); pad(c, 12)
    
    local f = I("Frame", {Size=UDim2.fromOffset(64,64), BackgroundColor3=T.surf3, BorderSizePixel=0}, c)
    round(f, 10); outline(f, T.border, 1)
    
    if not opts.confidential then
        local img = I("ImageLabel", {
            Size=UDim2.fromScale(1,1), BackgroundTransparency=1,
            Image="rbxthumb://type=GameIcon&id="..tostring(opts.placeId or 142823291).."&w=150&h=150",
            ScaleType=Enum.ScaleType.Crop
        }, f)
        round(img, 10)
    else
        lbl(f, "🔒", {textSize=24, xAlign=Enum.TextXAlignment.Center, yAlign=Enum.TextYAlignment.Center, size=UDim2.fromScale(1,1)})
    end
    
    lbl(c, placeName or "Unknown Place", {font=Enum.Font.GothamBold, textSize=14, size=UDim2.new(1,-80,0,20), pos=UDim2.fromOffset(76,8)})
    lbl(c, lobbyName or "Lobby", {textSize=12, color=T.muted, size=UDim2.new(1,-80,0,18), pos=UDim2.fromOffset(76,30)})
    lbl(c, "Хост: " .. (opts.hostName or "Unknown"), {textSize=11, color=T.muted, size=UDim2.new(1,-80,0,16), pos=UDim2.fromOffset(76,50)})
    
    local joinBtn = btn(c, "Войти", {size=UDim2.fromOffset(80,32), pos=UDim2.new(1,-80,0.5,-16), bg=T.accent, hoverBg=T.accent2, textSize=12})
    
    joinBtn.MouseButton1Click:Connect(function()
        if opts.confidential then
            promptPassword(function(pass)
                attemptJoin(opts.lobbyId, pass, opts.hostName)
            end)
        else
            attemptJoin(opts.lobbyId, nil, opts.hostName)
        end
    end)
    
    return c
end

attemptJoin = function(lobbyId, password, hostName)
    showToast(Main, "Подключение...", T.accent)
    local ok, res = httpJson(CATALOG_URL.."/api/lobby/join", "POST", {
        lobbyId = lobbyId,
        userId = MY_ID,
        userName = MY_NAME,
        password = password
    })
    
    if ok and res and res.token then
        State.session = {
            lobbyId = res.lobbyId,
            token = res.token,
            hostUrl = res.hostUrl,
            isHost = false
        }
        isOwnLobby = false
        currentLobby = {
            id = res.lobbyId,
            hostId = res.hostId or 0,
            hostName = hostName or "Unknown",
            whitelist = {}
        }
        currentWhitelistScope = currentLobby
        
        showLoadingSteps("Подключение к лобби", {
            {label = "Подключение к серверу...", fn = function()
                local ready = false
                local err = nil
                connectWebSocket(State.session.hostUrl, State.session.token, false, 
                    function() ready = true end, 
                    function(e) err = e end
                )
                local t = tick()
                while not ready and not err and tick() - t < 15 do task.wait(0.1) end
                if err then error(err) end
                if not ready then error("Таймаут подключения") end
                return true
            end},
        }, function()
            Main.Visible = false
            InPlace.Visible = true
            lastVisibleFrame = InPlace
            ipStatusLbl.Text = "● Активно (Гость)"
            ipSubtitleLbl.Text = currentLobby.hostName .. " | " .. currentLobby.id
            startHeartbeat()
            showToast(InPlace, "Вы в лобби!", T.success)
        end, function(err)
            showToast(Main, "Ошибка: " .. tostring(err), T.danger)
            State.session = nil
        end)
    else
        showToast(Main, "Ошибка: " .. tostring(res and res.error or "Неизвестно"), T.danger)
    end
end

publishLobby = function()
    local name = createNameBox.Text
    if name == "" then showToast(Create, "Введите название", T.danger); return end
    local pass = createPassBox.Text
    local hostUrl = createServ2Box.Text
    if hostUrl == "" then hostUrl = DEFAULT_HOST_URL end
    
    showToast(Create, "Создание лобби...", T.accent)
    
    local ok, res = httpJson(CATALOG_URL.."/api/lobby/create", "POST", {
        name = name,
        hostId = MY_ID,
        hostName = MY_NAME,
        password = pass ~= "" and pass or nil,
        isPrivate = confOn,
        hostUrl = hostUrl,
        placeId = game.PlaceId,
        placeName = game.Name
    })
    
    if ok and res and res.lobbyId and res.token then
        State.session = {
            lobbyId = res.lobbyId,
            token = res.token,
            hostUrl = res.hostUrl or hostUrl,
            isHost = true
        }
        isOwnLobby = true
        currentLobby = {
            id = res.lobbyId,
            hostId = MY_ID,
            hostName = MY_NAME,
            whitelist = {}
        }
        currentWhitelistScope = currentLobby
        
        showLoadingSteps("Подключение к лобби", {
            {label = "Подключение к серверу...", fn = function()
                local ready = false
                local err = nil
                connectWebSocket(State.session.hostUrl, State.session.token, true, 
                    function() ready = true end, 
                    function(e) err = e end
                )
                local t = tick()
                while not ready and not err and tick() - t < 15 do task.wait(0.1) end
                if err then error(err) end
                if not ready then error("Таймаут подключения к WS") end
                return true
            end},
            {label = "Отправка снапшота...", fn = function() task.wait(0.5); return true end},
        }, function()
            Main.Visible = false
            InPlace.Visible = true
            lastVisibleFrame = InPlace
            ipStatusLbl.Text = "● Активно (Хост)"
            ipSubtitleLbl.Text = game.Name .. " | " .. currentLobby.id
            startHeartbeat()
            showToast(InPlace, "Лобби создано!", T.success)
        end, function(err)
            showToast(Create, "Ошибка: " .. tostring(err), T.danger)
            State.session = nil
        end)
    else
        showToast(Create, "Ошибка: " .. tostring(res and res.error or "Неизвестно"), T.danger)
    end
end
publishBtn.MouseButton1Click:Connect(publishLobby)

directConnect = function()
    local url = directUrlBox.Text
    local token = directTokenBox.Text
    if url == "" or token == "" then showToast(Direct, "Заполните URL и токен", T.danger); return end
    
    State.session = { lobbyId = "direct", token = token, hostUrl = url, isHost = false }
    isOwnLobby = false
    currentLobby = { id = "direct", hostId = 0, hostName = "Direct", whitelist = {} }
    
    showLoadingSteps("Прямое подключение", {
        {label = "Подключение...", fn = function()
            local ready = false
            local err = nil
            connectWebSocket(url, token, false, function() ready = true end, function(e) err = e end)
            local t = tick()
            while not ready and not err and tick() - t < 15 do task.wait(0.1) end
            if err then error(err) end
            if not ready then error("Таймаут") end
            return true
        end}
    }, function()
        Main.Visible = false; InPlace.Visible = true; lastVisibleFrame = InPlace
        ipStatusLbl.Text = "● Прямое подключение"
        ipSubtitleLbl.Text = url
        startHeartbeat()
    end, function(err)
        showToast(Direct, "Ошибка: " .. tostring(err), T.danger)
        State.session = nil
    end)
end
directBtn.MouseButton1Click:Connect(directConnect)

startCatalogPoll = function()
    if State.catalogPollThread then task.cancel(State.catalogPollThread) end
    State.catalogPollThread = task.spawn(function()
        while true do
            if not State.session then
                local ok, res = httpJson(CATALOG_URL.."/api/lobby/list", "GET")
                if ok and res and res.lobbies then
                    State.remoteLobbies = res.lobbies
                    for _, ch in ipairs(aList:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
                    for _, ch in ipairs(aListAll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
                    
                    local myLobbies = {}
                    for _, l in ipairs(State.remoteLobbies) do
                        if l.hostId == MY_ID then table.insert(myLobbies, l) end
                    end
                    
                    if #myLobbies > 0 then
                        for _, l in ipairs(myLobbies) do
                            local c = card(l.placeName or "Unknown", l.name, 0, {placeId=l.placeId, confidential=false, hostName=l.hostName, lobbyId=l.id})
                            c.Parent = aList
                        end
                    else
                        lbl(aList, "Нет доступных мест", {textSize=12, color=T.muted, size=UDim2.new(1,0,0,20)})
                    end
                    
                    for _, l in ipairs(State.remoteLobbies) do
                        local c = card(l.placeName or "Unknown", l.name, 0, {placeId=l.placeId, confidential=l.hasPassword, hostName=l.hostName, lobbyId=l.id})
                        c.Parent = aListAll
                    end
                end
            end
            task.wait(CATALOG_POLL)
        end
    end)
end

--==================================================================
-- Init
--==================================================================
startWatching()
if Selection then Selection.SelectionChanged:Connect(function() pcall(onSelectionChanged) end) end

RunService.RenderStepped:Connect(function()
    if State.connected and workspace.CurrentCamera then
        local now = tick()
        if now - State.lastCamSend > 0.15 then
            local cam = workspace.CurrentCamera
            if (cam.CFrame.Position - State.lastCamPos.Position).Magnitude > 0.1 or now - State.lastCamSend > 1 then
                State.lastCamSend = now; State.lastCamPos = cam.CFrame
                sendDelta("camera", {cframe = {cam.CFrame:GetComponents()}})
            end
        end
    end
end)

switchTo("lobby")
startCatalogPoll()
logMsg("plugin", "success", "Plugin v5.4 loaded (roles→server1, synced markers, crown/mesh fixes)")
