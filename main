local function toggleRow(parent, label, yPos, initialOn, callback)
    local r = I("Frame", {Size=UDim2.new(1,0,0,44), Position=UDim2.fromOffset(0,yPos), BackgroundColor3=T.surface, BorderSizePixel=0}, parent)
    round(r, 8); outline(r, T.border, 1)
    lbl(r, label, {textSize=13, size=UDim2.new(1,-80,1,0), pos=UDim2.fromOffset(14,0)})
    local on = initialOn or false
    local tbg = I("Frame", {Size=UDim2.fromOffset(44,24), Position=UDim2.new(1,-60,0.5,-12), BackgroundColor3=on and T.accent or T.surf3, BorderSizePixel=0}, r)
    round(tbg, 12)
    local dot = I("Frame", {Size=UDim2.fromOffset(18,18), Position=on and UDim2.fromOffset(23,3) or UDim2.fromOffset(3,3), BackgroundColor3=T.text, BorderSizePixel=0}, tbg)
    round(dot, 9)
    I("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", ZIndex=5}, tbg).MouseButton1Click:Connect(function()
        on = not on; tbg.BackgroundColor3 = on and T.accent or T.surf3
        dot.Position = on and UDim2.fromOffset(23,3) or UDim2.fromOffset(3,3)
        if callback then callback(on) end
    end)
end

