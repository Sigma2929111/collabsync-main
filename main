local T = {
    bg=Color3.fromRGB(22,22,26), surface=Color3.fromRGB(32,32,38),
    surf2=Color3.fromRGB(42,42,50), surf3=Color3.fromRGB(54,54,64),
    border=Color3.fromRGB(62,62,74), accent=Color3.fromRGB(88,132,255),
    accent2=Color3.fromRGB(112,154,255), text=Color3.fromRGB(238,238,242),
    muted=Color3.fromRGB(150,150,165), success=Color3.fromRGB(76,200,120),
    danger=Color3.fromRGB(230,90,90), warn=Color3.fromRGB(240,180,60),
    gold=Color3.fromRGB(255,215,0), tester=Color3.fromRGB(100,170,255),
    bomb=Color3.fromRGB(15,15,15), trash=Color3.fromRGB(101,67,33),
    owner=Color3.fromRGB(255,100,255),
}

local function I(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do if k ~= "Parent" then o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function round(p, r) return I("UICorner", {CornerRadius=UDim.new(0,r or 8)}, p) end
local function outline(p, c, t) return I("UIStroke", {Color=c or T.border, Thickness=t or 1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, p) end
local function pad(p, v, h) h=h or v; return I("UIPadding", {PaddingTop=UDim.new(0,v), PaddingBottom=UDim.new(0,v), PaddingLeft=UDim.new(0,h), PaddingRight=UDim.new(0,h)}, p) end
local function lbl(parent, text, props)
    props = props or {}
    local hasBg = props.bg ~= nil
    return I("TextLabel", {
        Text=text, Font=props.font or Enum.Font.Gotham, TextSize=props.textSize or 14,
        TextColor3=props.color or T.text, BackgroundColor3=props.bg or T.surface,
        BackgroundTransparency=hasBg and 0 or 1, BorderSizePixel=0,
        TextXAlignment=props.xAlign or Enum.TextXAlignment.Left,
        TextYAlignment=props.yAlign or Enum.TextYAlignment.Center,
        TextTruncate=props.truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
        Size=props.size or UDim2.fromScale(1,1), Position=props.pos, AnchorPoint=props.anchor,
        RichText=props.rich or false, ZIndex=props.zIndex or 1, TextWrapped=props.wrapped or false,
        AutomaticSize=props.autoSize or Enum.AutomaticSize.None,
    }, parent)
end
local function btn(parent, text, props)
    props = props or {}
    local b = I("TextButton", {
        Text=text, Font=props.font or Enum.Font.GothamMedium, TextSize=props.textSize or 14,
        TextColor3=props.color or T.text, BackgroundColor3=props.bg or T.surf2,
        BackgroundTransparency=props.transparent and 1 or 0, AutoButtonColor=false, BorderSizePixel=0,
        TextXAlignment=Enum.TextXAlignment.Center, Size=props.size or UDim2.fromOffset(120,34),
        Position=props.pos, AnchorPoint=props.anchor, ZIndex=props.zIndex or 1,
    }, parent)
    round(b, props.corner or 8)
    if props.outline then outline(b, props.outline, 1) end
    local baseBg, baseTr = b.BackgroundColor3, b.BackgroundTransparency
    b.MouseEnter:Connect(function()
        if props.transparent then b.BackgroundTransparency = 0.85
        else b.BackgroundColor3 = props.hoverBg or T.accent end
    end)
    b.MouseLeave:Connect(function()
        b.BackgroundColor3 = baseBg; b.BackgroundTransparency = baseTr
    end)
    return b
end

local thumbCache = {}
local function getThumbAsync(uid)
    if thumbCache[uid] then return thumbCache[uid] end
    local ok, url = pcall(function() return Players:GetUserThumbnailAsync(uid, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150) end)
    if ok and url then thumbCache[uid] = url; return url end
    return "rbxthumb://type=AvatarHeadShot&id="..uid.."&w=150&h=150"
end
local function avatar(parent, size, uid)
    if not settings.showAvatars then return I("Frame", {Size=UDim2.fromOffset(size or 26, size or 26), BackgroundTransparency=1}, parent) end
    local holder = I("Frame", {Size=UDim2.fromOffset(size or 26, size or 26), BackgroundColor3=T.surf3, BorderSizePixel=0}, parent)
    round(holder, size or 26); outline(holder, T.bg, 2)
    local img = I("ImageLabel", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Image=getThumbAsync(uid or 1)}, holder)
    round(img, size or 26)
    task.spawn(function()
        local url = getThumbAsync(uid or 1)
        if img.Parent then img.Image = url end
    end)
    return holder
end

local function makeDraggable(frame, dragArea)
    local dragging, startPos, startInput = false, nil, nil
    dragArea.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; startPos = frame.Position; startInput = input.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - startInput
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end
local function showToast(parent, text, color)
    if not settings.showNotifications and color ~= T.danger then return end
    if not parent then return end
    local t = I("TextLabel", {Text=text, Font=Enum.Font.GothamMedium, TextSize=13, TextColor3=Color3.new(1,1,1),
        BackgroundColor3=color or T.accent, BorderSizePixel=0, Size=UDim2.fromOffset(360,40),
        Position=UDim2.new(0.5,-180,1,-70), ZIndex=90}, parent)
    round(t, 8); outline(t, color or T.accent, 1)
    task.delay(4, function() if t and t.Parent then t:Destroy() end end)
end
local function applyTheme(isDark)
    local nb, ns = isDark and Color3.fromRGB(22,22,26) or Color3.fromRGB(240,240,245),
                    isDark and Color3.fromRGB(32,32,38) or Color3.fromRGB(255,255,255)
    local ns2, ns3 = isDark and Color3.fromRGB(42,42,50) or Color3.fromRGB(230,230,235),
                     isDark and Color3.fromRGB(54,54,64) or Color3.fromRGB(210,210,215)
    local nt, nm = isDark and Color3.fromRGB(238,238,242) or Color3.fromRGB(30,30,35),
                   isDark and Color3.fromRGB(150,150,165) or Color3.fromRGB(100,100,110)
    local ob, os, os2, os3, ot, om = T.bg, T.surface, T.surf2, T.surf3, T.text, T.muted
    T.bg, T.surface, T.surf2, T.surf3, T.text, T.muted = nb, ns, ns2, ns3, nt, nm
    if not root then return end
    for _, v in ipairs(root:GetDescendants()) do
        if v:IsA("Frame") or v:IsA("TextButton") or v:IsA("TextBox") then
            if v.BackgroundColor3 == ob then v.BackgroundColor3 = nb end
            if v.BackgroundColor3 == os then v.BackgroundColor3 = ns end
            if v.BackgroundColor3 == os2 then v.BackgroundColor3 = ns2 end
            if v.BackgroundColor3 == os3 then v.BackgroundColor3 = ns3 end
        end
        if v:IsA("TextLabel") or v:IsA("TextButton") or v:IsA("TextBox") then
            if v.TextColor3 == ot then v.TextColor3 = nt end
            if v.TextColor3 == om then v.TextColor3 = nm end
        end
        if v:IsA("UIStroke") and v.Color == T.border then v.Color = isDark and Color3.fromRGB(62,62,74) or Color3.fromRGB(200,200,205) end
    end
end
local function httpJson(url, method, body, headers)
    local opts = {Url=url, Method=method or "GET", Headers=headers or {["Content-Type"]="application/json"}}
    if body then opts.Body = HttpService:JSONEncode(body) end
    for attempt = 1, 3 do
        local ok, res = pcall(function() return HttpService:RequestAsync(opts) end)
        if not ok then
            if attempt < 3 then task.wait(5) else return false, "Сеть: "..tostring(res), 0 end
        elseif res.Success then
            local dok, dres = pcall(function() return HttpService:JSONDecode(res.Body) end)
            return true, (dok and dres) or res.Body, res.StatusCode
        else
            if res.StatusCode >= 500 and attempt < 3 then task.wait(5)
            else
                local dok, dres = pcall(function() return HttpService:JSONDecode(res.Body) end)
                return false, (dok and dres) or {error="HTTP "..res.StatusCode}, res.StatusCode
            end
        end
    end
    return false, "Таймаут сервера", 0
end

resolveName = function(uid)
    if not uid or uid == 0 then return "—" end
    if uid == MY_ID then return MY_NAME end
    if State.nameCache[uid] then return State.nameCache[uid] end
    pcall(function() local n = Players:GetNameFromUserIdAsync(uid); State.nameCache[uid] = n end)
    return State.nameCache[uid] or ("User "..uid)
end
getRoles = function(uid)
    if uid == MY_ID then return MY_ROLES end
    -- Prefer roles supplied via WS (which now come from server1 on the client's own init)
    for _, p in ipairs(State.remotePlayers or {}) do
        if p.userId == uid and p.roles and (p.roles.isOwner or p.roles.isTester or p.roles.isBomb or p.roles.isTrash) then
            return p.roles
        end
    end
    if roleCache[uid] then return roleCache[uid] end
    -- Lazy fetch from server1
    if not roleFetchInFlight[uid] then
        roleFetchInFlight[uid] = true
        fetchRoles(uid, nil, function(r)
            roleFetchInFlight[uid] = nil
            if r then
                roleCache[uid] = r
                if _G.__collabsync_refresh_styles then pcall(_G.__collabsync_refresh_styles) end
            end
        end)
    end
    return {isOwner=false, isTester=false, isBomb=false, isTrash=false}
end
isTester = function(uid) local r = getRoles(uid); return r and r.isTester or false end
isBomb = function(uid) local r = getRoles(uid); return r and r.isBomb or false end
isOwner = function(uid) local r = getRoles(uid); return r and r.isOwner or false end
isTrash = function(uid) local r = getRoles(uid); return r and r.isTrash or false end
isLobbyHost = function(uid) return currentLobby and currentLobby.hostId == uid end

nameColor = function(uid)
    if not uid then return T.text end
    if isOwner(uid) then return T.owner end
    if isLobbyHost(uid) then return T.gold end
    if isTester(uid) then return T.tester end
    if isTrash(uid) then return T.trash end
    if isBomb(uid) then return T.bomb end
    return T.text
end
sphereColor = function(uid)
    if not uid then return T.text end
    if isLobbyHost(uid) then return T.gold end
    if isTester(uid) then return T.tester end
    if isTrash(uid) then return T.trash end
    if isBomb(uid) then return T.bomb end
    if isOwner(uid) then return T.owner end
    return Color3.fromRGB((uid*17)%150+100, (uid*31)%150+100, (uid*53)%150+100)
end

formatName = function(uid)
    local base = resolveName(uid)
    local prefix, suffix = "", ""
    if isTrash(uid) then prefix = "🗑️ " end
    if isLobbyHost(uid) then prefix = "👑 " .. prefix end
    if isOwner(uid) then prefix = "⭐ " .. prefix end
    if isTester(uid) then prefix = "🧪 " .. prefix end
    if isBomb(uid) then suffix = " 💣" end
    return prefix..base..suffix
end

sphereName = function(uid)
    return resolveName(uid)
end

local function startGradientAnimator()
    task.spawn(function()
        while true do
            task.wait(0.05)
            for i = #State.animGradients, 1, -1 do
                local e = State.animGradients[i]
                if not e.label or not e.label.Parent or not e.grad then
                    table.remove(State.animGradients, i)
                else
                    e.grad.Rotation = (e.grad.Rotation + 10) % 360
                end
            end
        end
    end)
end
startGradientAnimator()

applyNameStyle = function(label, uid, noEmoji)
    if not label or not uid then return end
    label.TextColor3 = nameColor(uid)
    if isBomb(uid) then
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(230, 230, 230)
    end
    if isTrash(uid) then
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(60, 40, 20)
    end
    if isOwner(uid) then
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,50,50)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,180,50)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255,255,50)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(50,255,50)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(50,200,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(130,50,255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,50,150)),
        })
        grad.Parent = label
        table.insert(State.animGradients, {label=label, grad=grad})
    elseif isLobbyHost(uid) or isTester(uid) then
        local base = nameColor(uid)
        local brighter = Color3.fromRGB(math.min(255, base.R + 90), math.min(255, base.G + 90), math.min(255, base.B + 90))
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, base),
            ColorSequenceKeypoint.new(0.5, brighter),
            ColorSequenceKeypoint.new(1, base),
        })
        grad.Parent = label
        table.insert(State.animGradients, {label=label, grad=grad})
    end
end

applySphereStyle = function(label, uid)
    if not label or not uid then return end
    label.TextColor3 = sphereColor(uid)
    if isOwner(uid) then
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,50,50)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,180,50)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255,255,50)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(50,255,50)),
            ColorSequenceKeypoint.new(0.66, Color3.fromRGB(50,200,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(130,50,255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,50,150)),
        })
        grad.Parent = label
        table.insert(State.animGradients, {label=label, grad=grad})
    end
end

local function lookupUser(query)
    if not query or query == "" then return nil end
    local uid = tonumber(query)
    if uid then return {uid=uid, name=resolveName(uid)} end
    local ok, result = pcall(function() return Players:GetNameFromUserIdAsync(query) end)
    if not ok or not result then return nil end
    State.nameCache[result] = query
    return {uid=result, name=query}
end

--==================================================================
-- Collabsync Model + Markers
--==================================================================
local CollabsyncModel = nil
local TeammateTemplate = nil
local OwnerTeammateTemplate = nil

local function ensureCollabsyncModel()
    local existing = ServerStorage:FindFirstChild("Collabsync model")
    if existing then
        CollabsyncModel = existing
        return true
    end
    local ok, loaded = pcall(function() return InsertService:LoadAsset(COLLABSYNC_ASSET_ID) end)
    if not ok or not loaded then
        logMsg("plugin", "warn", "Не удалось загрузить Collabsync model")
        return false
    end
    local children = loaded:GetChildren()
    if #children > 0 then
        local main = children[1]
        main.Name = "Collabsync model"
        main.Archivable = true
        main.Parent = ServerStorage
        CollabsyncModel = main
    end
    loaded:Destroy()
    logMsg("plugin", "info", "Collabsync model загружен")
    return CollabsyncModel ~= nil
end

local function findTemplates()
    if not CollabsyncModel then return end
    local t = CollabsyncModel:FindFirstChild("Teammate")
    local o = CollabsyncModel:FindFirstChild("OwnerTeammate")
    if t then t.Archivable = true; TeammateTemplate = t end
    if o then o.Archivable = true; OwnerTeammateTemplate = o end
    logMsg("plugin", "info", "Templates: Teammate="..tostring(TeammateTemplate ~= nil).." Owner="..tostring(OwnerTeammateTemplate ~= nil))
end
task.spawn(function()
    if ensureCollabsyncModel() then findTemplates() end
end)

local function setMarkerRootCF(marker, cf)
    if marker:IsA("Model") then
        marker:PivotTo(cf)
    elseif marker:IsA("BasePart") then
        marker.CFrame = cf
    end
end

local function computeMarkerOffsets(uid)
    local marker = State.localMarkers[uid]
    if not marker or not marker.Parent then return end
    local rootCF = marker:IsA("Model") and marker:GetPivot() or marker.CFrame
    local offsets = {}
    for _, desc in ipairs(marker:GetDescendants()) do
        if desc:IsA("BasePart") and desc ~= marker then
            offsets[desc] = rootCF:ToObjectSpace(desc.CFrame)
        end
    end
    State.markerLocalOffsets[uid] = offsets
end

local function buildFallbackMarker(uid)
    local m = Instance.new("Part")
    m.Name = "_CS_Marker_"..uid
    m.Shape = Enum.PartType.Ball
    m.Size = Vector3.new(1.2, 1.2, 1.2)
    m.Transparency = 0.4
    m.Anchored = true
    m.CanCollide = false; m.CanQuery = false; m.CanTouch = false
    m.Locked = true
    m.Material = Enum.Material.Neon
    m.Color = sphereColor(uid)
    m:SetAttribute("_CS_Skip", true)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(0, 200, 0, 40)
    bb.StudsOffset = Vector3.new(0, 1.2, 0)
    bb.AlwaysOnTop = true
    bb:SetAttribute("_CS_Skip", true); bb.Parent = m
    local tl = Instance.new("TextLabel")
    tl.Size = UDim2.fromScale(1,1)
    tl.BackgroundTransparency = 1
    tl.Font = Enum.Font.GothamBold
    tl.TextScaled = true
    tl.Text = sphereName(uid)
    tl:SetAttribute("_CS_Skip", true); tl.Parent = bb
    applySphereStyle(tl, uid)
    return m
end

setupMarkerRotation = function(marker, uid)
    local handle = nil
    local group = {}
    for _, desc in ipairs(marker:GetDescendants()) do
        if desc:IsA("BasePart") then
            if desc.Name == "Handle" then 
                handle = desc
            elseif desc.Name == "Liquid" or desc.Name == "Union" or desc.Name == "MeshPart" then
                table.insert(group, desc)
            end
        end
    end
    local rootCF = marker:IsA("Model") and marker:GetPivot() or marker.CFrame
    local data = { startTime = tick() }
    
    if handle then
        data.handle = handle
        data.handleLocal = rootCF:ToObjectSpace(handle.CFrame)
    end
    if #group > 0 then
        local centerSum = Vector3.new()
        local locals = {}
        for _, p in ipairs(group) do
            local lcf = rootCF:ToObjectSpace(p.CFrame)
            centerSum = centerSum + lcf.Position
            table.insert(locals, {part=p, localCF=lcf})
        end
        data.groupCenter = centerSum / #group
        data.group = locals
    end
    State.markerRotations[uid] = data
end

updateMarkerRotation = function(uid, rootCF)
    local data = State.markerRotations[uid]
    if not data then return end
    local t = (tick() - data.startTime) * 1.8
    
    if data.handle and data.handle.Parent then
        State.applyingRemote[data.handle] = true
        pcall(function()
            data.handle.CFrame = rootCF * data.handleLocal * CFrame.Angles(0, t, 0)
        end)
        task.delay(0.02, function() State.applyingRemote[data.handle] = nil end)
    end
    
    if data.group then
        local c = data.groupCenter
        for _, entry in ipairs(data.group) do
            if entry.part and entry.part.Parent then
                State.applyingRemote[entry.part] = true
                pcall(function()
                    local pivot = CFrame.new(c) * CFrame.Angles(0, t, 0) * CFrame.new(-c)
                    entry.part.CFrame = rootCF * pivot * entry.localCF
                end)
                task.delay(0.02, function() State.applyingRemote[entry.part] = nil end)
            end
        end
    end
end

protectMarker = function(marker, uid)
    local origName = marker.Name
    marker:SetAttribute("_CS_OrigName", origName)
    marker:GetPropertyChangedSignal("Name"):Connect(function()
        if not State.applyingRemote[marker] and marker.Name ~= origName then
            marker.Name = origName
        end
    end)
    for _, desc in ipairs(marker:GetDescendants()) do
        if desc:IsA("TextLabel") then
            local origText = desc.Text
            local origColor = desc.TextColor3
            desc:SetAttribute("_CS_OrigText", origText)
            desc:GetPropertyChangedSignal("Text"):Connect(function()
                if not State.applyingRemote[desc] and desc.Text ~= origText then
                    desc.Text = origText
                end
            end)
            desc:GetPropertyChangedSignal("TextColor3"):Connect(function()
                if not State.applyingRemote[desc] then
                    desc.TextColor3 = origColor
                end
            end)
        elseif desc:IsA("BasePart") then
            local origSize = desc.Size
            local origColor = desc.Color
            desc:GetPropertyChangedSignal("Size"):Connect(function()
                if not State.applyingRemote[desc] then desc.Size = origSize end
            end)
            desc:GetPropertyChangedSignal("Color"):Connect(function()
                if not State.applyingRemote[desc] then desc.Color = origColor end
            end)
        end
    end
end

local function findCrownSource(t)
    if not t then return nil end
    return t:FindFirstChild("Crown", true)
end

refreshMarkerStyle = function(uid)
    local marker = State.localMarkers[uid]
    if not marker or not marker.Parent then return end
    local col = sphereColor(uid)
    
    for _, desc in ipairs(marker:GetDescendants()) do
        if desc:IsA("BasePart") then
            State.applyingRemote[desc] = true
            pcall(function() desc.Color = col end)
            task.delay(0.05, function() State.applyingRemote[desc] = nil end)
        elseif desc:IsA("SphereHandleAdornment") or desc:IsA("ConeHandleAdornment") or desc:IsA("CylinderHandleAdornment") then
            pcall(function() desc.Color3 = col end)
        elseif desc:IsA("TextLabel") then
            State.applyingRemote[desc] = true
            pcall(function()
                desc.Text = sphereName(uid)
                desc.TextColor3 = col
            end)
            task.delay(0.05, function() State.applyingRemote[desc] = nil end)
        end
    end
    
    -- === Crown logic (fixed) ===
    local crown = marker:FindFirstChild("Crown", true)
    if crown and not isLobbyHost(uid) then
        pcall(function() crown:Destroy() end)
    elseif not crown and isLobbyHost(uid) then
        -- Always try own template first, then the other, then any
        local sourceTemplates = {}
        if isOwner(uid) then
            table.insert(sourceTemplates, OwnerTeammateTemplate)
            table.insert(sourceTemplates, TeammateTemplate)
        else
            table.insert(sourceTemplates, TeammateTemplate)
            table.insert(sourceTemplates, OwnerTeammateTemplate)
        end
        local crownSrc, sourceTemplate = nil, nil
        for _, t in ipairs(sourceTemplates) do
            local c = findCrownSource(t)
            if c then crownSrc = c; sourceTemplate = t; break end
        end
        if crownSrc and sourceTemplate then
            local newCrown = crownSrc:Clone()
            newCrown:SetAttribute("_CS_Skip", true)
            -- Compute relative offset within source template, apply to current marker position
            local sourceRootCF
            if sourceTemplate:IsA("Model") then
                sourceRootCF = sourceTemplate:GetPivot()
            elseif sourceTemplate:IsA("BasePart") then
                sourceRootCF = sourceTemplate.CFrame
            end
            if sourceRootCF then
                local crownCF
                if crownSrc:IsA("Model") then crownCF = crownSrc:GetPivot()
                elseif crownSrc:IsA("BasePart") then crownCF = crownSrc.CFrame end
                if crownCF then
                    local localCF = sourceRootCF:ToObjectSpace(crownCF)
                    local markerRootCF = marker:IsA("Model") and marker:GetPivot() or marker.CFrame
                    local targetCF = markerRootCF * localCF
                    if newCrown:IsA("Model") then
                        pcall(function() newCrown:PivotTo(targetCF) end)
                    elseif newCrown:IsA("BasePart") then
                        pcall(function() newCrown.CFrame = targetCF end)
                    end
                end
            end
            newCrown.Parent = marker
            -- Recompute marker offsets so crown follows on next move
            task.defer(function()
                if State.localMarkers[uid] == marker and marker.Parent then
                    computeMarkerOffsets(uid)
                end
            end)
            logMsg("lobby", "info", "Корона добавлена для хоста "..sphereName(uid))
        end
    end
end

createLocalMarker = function(uid, name)
    if uid == MY_ID then return end
    if State.localMarkers[uid] then return end
    if markerLocks[uid] then return end
    markerLocks[uid] = true
    local ok, err = pcall(function()
        if not TeammateTemplate and not OwnerTeammateTemplate then
            if not ensureCollabsyncModel() then
                State.localMarkers[uid] = buildFallbackMarker(uid)
                State.localMarkers[uid].Parent = workspace
                return
            end
            findTemplates()
        end
        local isOwnerUser = isOwner(uid)
        local template = isOwnerUser and OwnerTeammateTemplate or TeammateTemplate
        local marker = nil
        if template then
            local cok, cloned = pcall(function() return template:Clone() end)
            if cok and cloned then marker = cloned end
        end
        if not marker then
            marker = buildFallbackMarker(uid)
            marker.Parent = workspace
            State.localMarkers[uid] = marker
            return
        end
        marker.Name = "_CS_Marker_"..uid
        marker:SetAttribute("_CS_Skip", true)
        marker.Archivable = false
        if not isLobbyHost(uid) then
            local crown = marker:FindFirstChild("Crown", true)
            if crown then pcall(function() crown:Destroy() end) end
        end
        local col = sphereColor(uid)
        for _, desc in ipairs(marker:GetDescendants()) do
            desc:SetAttribute("_CS_Skip", true)
            if desc:IsA("BasePart") then
                pcall(function() desc.Color = col end)
                desc.Locked = true
                desc.Anchored = true
                desc.CanCollide = false
                desc.CanQuery = false
                desc.CanTouch = false
            elseif desc:IsA("SphereHandleAdornment") or desc:IsA("ConeHandleAdornment") or desc:IsA("CylinderHandleAdornment") then
                pcall(function() desc.Color3 = col; desc.Transparency = 0.15; desc.AlwaysOnTop = false end)
            elseif desc:IsA("TextLabel") then
                desc.Text = sphereName(uid)
                applySphereStyle(desc, uid)
            end
        end
        if workspace.CurrentCamera then setMarkerRootCF(marker, workspace.CurrentCamera.CFrame) end
        marker.Parent = workspace
        State.localMarkers[uid] = marker
        computeMarkerOffsets(uid)
        if isOwnerUser then setupMarkerRotation(marker, uid) end
        protectMarker(marker, uid)
    end)
    markerLocks[uid] = nil
    if not ok then
        logMsg("plugin", "error", "createLocalMarker("..tostring(uid).."): "..tostring(err))
        State.localMarkers[uid] = nil
    end
end

updateLocalMarker = function(uid, cframe)
    local marker = State.localMarkers[uid]
    if not marker or not marker.Parent then return end
    State.applyingRemote[marker] = true
    setMarkerRootCF(marker, cframe)
    local offsets = State.markerLocalOffsets[uid]
    if offsets then
        for desc, offset in pairs(offsets) do
            if desc and desc.Parent then
                local rotData = State.markerRotations[uid]
                local isRotPart = false
                if rotData then
                    if rotData.handle == desc then isRotPart = true end
                    if rotData.group then
                        for _, e in ipairs(rotData.group) do if e.part == desc then isRotPart = true; break end end
                    end
                end
                if not isRotPart then
                    State.applyingRemote[desc] = true
                    pcall(function() desc.CFrame = cframe * offset end)
                end
            end
        end
    end
    if State.markerRotations[uid] then updateMarkerRotation(uid, cframe) end
    task.delay(0.05, function()
        State.applyingRemote[marker] = nil
        if offsets then for desc in pairs(offsets) do State.applyingRemote[desc] = nil end end
    end)
end

destroyLocalMarker = function(uid)
    local m = State.localMarkers[uid]
    if m and typeof(m) ~= "boolean" then pcall(function() m:Destroy() end) end
    State.localMarkers[uid] = nil
    State.markerLocalOffsets[uid] = nil
    State.markerRotations[uid] = nil
    for i = #State.animGradients, 1, -1 do
        local e = State.animGradients[i]
        if not e.label or not e.label.Parent then table.remove(State.animGradients, i) end
    end
end

processPendingMarkers = function()
    if not State.synced then return end
    if not State.connected then return end
    for _, p in ipairs(State.remotePlayers or {}) do
        if p.userId ~= MY_ID and not State.localMarkers[p.userId] then
            createLocalMarker(p.userId, p.userName)
        end
    end
    for uid in pairs(State.localMarkers) do
        refreshMarkerStyle(uid)
    end
end

--==================================================================
-- Serialization
--==================================================================
local SYNC_SERVICES = {
    game:GetService("Workspace"), game:GetService("ServerScriptService"),
    game:GetService("ReplicatedStorage"), game:GetService("StarterPlayer"),
    game:GetService("ServerStorage"),
}

local SKIP_CLASSES = {
    Terrain=true, Camera=true, Sound=true,
    UIGradient=true, UIStroke=true, UICorner=true, UIPadding=true,
    UIListLayout=true, UIGridLayout=true, UITableLayout=true,
    UIPageLayout=true, UIScale=true, UIAspectRatioConstraint=true,
    UISizeConstraint=true, UIPositionConstraint=true, UITextSizeConstraint=true,
    Highlight=true, SelectionBox=true,
}

local function shouldSkip(inst) return SKIP_CLASSES[inst.ClassName] == true end

local nextId = 0
local function generateId() nextId = nextId + 1; return tostring(os.time()).."_"..tostring(nextId).."_"..tostring(math.random(1000,9999)) end
local function getOrSetId(inst)
    local id = inst:GetAttribute("_CS_Id")
    if not id then id = generateId(); inst:SetAttribute("_CS_Id", id); State.objectMap[id] = inst end
    return id
end
local function hasSkipAncestor(inst)
    local cur = inst
    while cur and cur ~= game do
        if cur:GetAttribute("_CS_Skip") then return true end
        if SKIP_CLASSES[cur.ClassName] then return true end
        cur = cur.Parent
    end
    return false
end

local function normalizeMeshId(s)
    if not s or s == "" or s == "rbxassetid://0" or s == "rbxassetid://" then return nil end
    if s:match("^%d+$") then return "rbxassetid://"..s end
    return s
end

local function sanitizeProps(props)
    if not props then return end
    for _, key in ipairs({"MeshId", "TextureID", "TextureId", "Texture"}) do
        if props[key] == "" or props[key] == "rbxassetid://0" or props[key] == "rbxassetid://" then props[key] = nil end
    end
    if props.MeshId then props.MeshId = normalizeMeshId(props.MeshId) end
end

local function applyProps(inst, props, attrs)
    if not props then return end
    if inst:IsA("MeshPart") then
        if props.MeshId then
            local cur = ""; pcall(function() cur = inst.MeshId end)
            local norm = normalizeMeshId(props.MeshId) or props.MeshId
            if cur ~= norm then pcall(function() inst.MeshId = norm end) end
        end
        if props.TextureID then pcall(function() inst.TextureID = normalizeMeshId(props.TextureID) or props.TextureID end) end
    end
    if inst:IsA("DataModelMesh") then
        if props.MeshType and inst:IsA("SpecialMesh") then pcall(function() inst.MeshType = Enum.MeshType[props.MeshType] end) end
        if props.MeshId then pcall(function() inst.MeshId = normalizeMeshId(props.MeshId) or props.MeshId end) end
        if props.TextureId then pcall(function() inst.TextureId = normalizeMeshId(props.TextureId) or props.TextureId end) end
        if props.Scale then pcall(function() inst.Scale = Vector3.new(unpack(props.Scale)) end) end
        if props.Offset then pcall(function() inst.Offset = Vector3.new(unpack(props.Offset)) end) end
        if props.VertexColor and inst:IsA("SpecialMesh") then pcall(function() inst.VertexColor = Vector3.new(unpack(props.VertexColor)) end) end
    end
    if inst:IsA("Motor6D") or inst:IsA("Weld") or inst:IsA("Snap") then
        if props.C0 then pcall(function() inst.C0 = CFrame.new(unpack(props.C0)) end) end
        if props.C1 then pcall(function() inst.C1 = CFrame.new(unpack(props.C1)) end) end
        if props.Transform and inst:IsA("Motor6D") then pcall(function() inst.Transform = CFrame.new(unpack(props.Transform)) end) end
        if props.Part0Id and State.objectMap[props.Part0Id] then pcall(function() inst.Part0 = State.objectMap[props.Part0Id] end) end
        if props.Part1Id and State.objectMap[props.Part1Id] then pcall(function() inst.Part1 = State.objectMap[props.Part1Id] end) end
    end
    if inst:IsA("Humanoid") then
        if props.Health then pcall(function() inst.Health = props.Health end) end
        if props.MaxHealth then pcall(function() inst.MaxHealth = props.MaxHealth end) end
        if props.WalkSpeed then pcall(function() inst.WalkSpeed = props.WalkSpeed end) end
        if props.JumpPower then pcall(function() inst.JumpPower = props.JumpPower end) end
        if props.HipHeight then pcall(function() inst.HipHeight = props.HipHeight end) end
        if props.RigType then pcall(function() inst.RigType = Enum.HumanoidRigType[props.RigType] end) end
    end
    if inst:IsA("BasePart") then
        if props.CFrame then pcall(function() inst.CFrame = CFrame.new(unpack(props.CFrame)) end) end
        if props.Size then pcall(function() inst.Size = Vector3.new(unpack(props.Size)) end) end
        if props.Color then pcall(function() inst.Color = Color3.new(unpack(props.Color)) end) end
        if props.Transparency ~= nil then pcall(function() inst.Transparency = props.Transparency end) end
        if props.Reflectance ~= nil then pcall(function() inst.Reflectance = props.Reflectance end) end
        if props.Anchored ~= nil then pcall(function() inst.Anchored = props.Anchored end) end
        if props.CanCollide ~= nil then pcall(function() inst.CanCollide = props.CanCollide end) end
        if props.CanQuery ~= nil then pcall(function() inst.CanQuery = props.CanQuery end) end
        if props.CanTouch ~= nil then pcall(function() inst.CanTouch = props.CanTouch end) end
        if props.CastShadow ~= nil then pcall(function() inst.CastShadow = props.CastShadow end) end
        if props.Massless ~= nil then pcall(function() inst.Massless = props.Massless end) end
        if props.Locked ~= nil then pcall(function() inst.Locked = props.Locked end) end
        if props.Material then pcall(function() inst.Material = Enum.Material[props.Material] end) end
        if props.Shape and inst:IsA("Part") then pcall(function() inst.Shape = Enum.PartType[props.Shape] end) end
    end
    if inst:IsA("Decal") or inst:IsA("Texture") then
        if props.Texture then pcall(function() inst.Texture = normalizeMeshId(props.Texture) or props.Texture end) end
        if props.Color3 and inst:IsA("Decal") then pcall(function() inst.Color3 = Color3.new(unpack(props.Color3)) end) end
        if props.Transparency ~= nil then pcall(function() inst.Transparency = props.Transparency end) end
        if props.Face and inst:IsA("FaceInstance") then pcall(function() inst.Face = Enum.NormalId[props.Face] end) end
    end
    if inst:IsA("Shirt") or inst:IsA("Pants") or inst:IsA("ShirtGraphic") then
        if props.Template then pcall(function() inst.Template = props.Template end) end
    end
    if inst:IsA("LuaSourceContainer") and props.Source then
        pcall(function() inst.Source = props.Source end)
        State.scriptCache[inst] = props.Source
    end
    if attrs then
        for k, v in pairs(attrs) do
            if k ~= "_CS_Id" and k ~= "_CS_ParentId" and k ~= "_CS_Skip" and k ~= "_CS_ToolboxAssetId" then
                pcall(function() inst:SetAttribute(k, v) end)
            end
        end
    end
end

local function serializeInstance(inst)
    local ok, result = pcall(function()
        if inst:IsA("Terrain") or inst:IsA("Camera") then return nil end
        if inst.Name:match("^_CS_") then return nil end
        if hasSkipAncestor(inst) then return nil end
        if shouldSkip(inst) then return nil end
        
        local id = getOrSetId(inst)
        local parent = inst.Parent
        local parentId
        if parent == game then parentId = "game"
        elseif parent and parent.Parent == game then parentId = "service:"..parent.Name
        else parentId = parent and getOrSetId(parent) or "game" end
        
        if inst:IsA("Model") then
            local assetId = inst:GetAttribute("_ToolboxAssetId") or inst:GetAttribute("AssetId")
            if assetId and tonumber(assetId) then
                return {id=id, parentId=parentId, className="__ToolboxModel__", name=inst.Name, props={assetId=tostring(assetId)}, attrs={}}
            end
        end
        
        local props = {}
        
        if inst:IsA("BasePart") then
            props.CFrame = {inst.CFrame:GetComponents()}
            props.Size = {inst.Size.X, inst.Size.Y, inst.Size.Z}
            props.Color = {inst.Color.R, inst.Color.G, inst.Color.B}
            props.Transparency = inst.Transparency
            props.Reflectance = inst.Reflectance
            props.Anchored = inst.Anchored
            props.CanCollide = inst.CanCollide
            props.CanQuery = inst.CanQuery
            props.CanTouch = inst.CanTouch
            props.CastShadow = inst.CastShadow
            props.Massless = inst.Massless
            props.Locked = inst.Locked
            props.Material = inst.Material.Name
            if inst:IsA("Part") then props.Shape = inst.Shape.Name end
            if inst:IsA("MeshPart") then
                local mid = ""; pcall(function() mid = inst.MeshId end)
                local norm = normalizeMeshId(mid)
                if norm then props.MeshId = norm end
                local tid = ""; pcall(function() tid = inst.TextureID end)
                local ntid = normalizeMeshId(tid)
                if ntid then props.TextureID = ntid end
            end
        elseif inst:IsA("Motor6D") or inst:IsA("Weld") or inst:IsA("Snap") then
            props.C0 = {inst.C0:GetComponents()}
            props.C1 = {inst.C1:GetComponents()}
            if inst:IsA("Motor6D") then props.Transform = {inst.Transform:GetComponents()} end
            if inst.Part0 then props.Part0Id = inst.Part0:GetAttribute("_CS_Id") end
            if inst.Part1 then props.Part1Id = inst.Part1:GetAttribute("_CS_Id") end
        elseif inst:IsA("Humanoid") then
            props.Health = inst.Health
            props.MaxHealth = inst.MaxHealth
            props.WalkSpeed = inst.WalkSpeed
            props.JumpPower = inst.JumpPower
            props.HipHeight = inst.HipHeight
            props.RigType = inst.RigType.Name
        elseif inst:IsA("DataModelMesh") then
            if inst:IsA("SpecialMesh") then pcall(function() props.MeshType = inst.MeshType.Name end) end
            local mid = ""; pcall(function() mid = inst.MeshId end)
            local norm = normalizeMeshId(mid); if norm then props.MeshId = norm end
            local tid = ""; pcall(function() tid = inst.TextureId end)
            local ntid = normalizeMeshId(tid); if ntid then props.TextureId = ntid end
            props.Scale = {inst.Scale.X, inst.Scale.Y, inst.Scale.Z}
            props.Offset = {inst.Offset.X, inst.Offset.Y, inst.Offset.Z}
            if inst:IsA("SpecialMesh") then pcall(function() local vc = inst.VertexColor; if vc then props.VertexColor = {vc.X, vc.Y, vc.Z} end end) end
        elseif inst:IsA("LuaSourceContainer") then
            props.Source = inst.Source
        elseif inst:IsA("Decal") or inst:IsA("Texture") then
            local tex = ""; pcall(function() tex = inst.Texture end)
            local ntex = normalizeMeshId(tex); if ntex then props.Texture = ntex end
            if inst:IsA("Decal") then props.Color3 = {inst.Color3.R, inst.Color3.G, inst.Color3.B}; props.Transparency = inst.Transparency end
            pcall(function() props.Face = inst.Face.Name end)
        elseif inst:IsA("Shirt") or inst:IsA("Pants") or inst:IsA("ShirtGraphic") then
            local tmpl = ""; pcall(function() tmpl = inst.Template or inst.Graphic end)
            if tmpl and tmpl ~= "" then props.Template = tmpl end
        end
        
        local attrs = {}
        for k, v in pairs(inst:GetAttributes()) do
            if k ~= "_CS_Id" and k ~= "_CS_ParentId" and k ~= "_CS_Skip" and k ~= "_CS_ToolboxAssetId" then attrs[k] = v end
        end
        return {id=id, parentId=parentId, className=inst.ClassName, name=inst.Name, props=props, attrs=attrs}
    end)
    if ok then return result end
    return nil
end

local function buildTree(inst, out, limit)
    if limit and #out >= limit then return end
    local s = serializeInstance(inst)
    if s then table.insert(out, s) end
    if limit and #out >= limit then return end
    for _, child in ipairs(inst:GetChildren()) do 
        if limit and #out >= limit then return end
        buildTree(child, out, limit) 
    end
end
local function buildSnapshot()
    local out = {}
    for _, svc in ipairs(SYNC_SERVICES) do
        for _, inst in ipairs(svc:GetChildren()) do 
            if #out >= 60000 then break end
            buildTree(inst, out, 60000) 
        end
        if #out >= 60000 then break end
    end
    return out
end
local function sendDelta(kind, data)
    if not State.wsClient or not State.connected then return end
    local payload = {type="delta", id=HttpService:GenerateGUID(false), kind=kind, userId=MY_ID, userName=MY_NAME, ts=os.time()}
    for k, v in pairs(data) do payload[k] = v end
    pcall(function() State.wsClient:Send(HttpService:JSONEncode(payload)) end)
end

watchInstance = function(inst)
    if State.watched[inst] then return end
    if inst.Name:match("^_CS_") then return end
    if hasSkipAncestor(inst) then return end
    if shouldSkip(inst) then return end
    State.watched[inst] = true
    getOrSetId(inst)
    local function scheduleUpdate(prop)
        if State.applyingRemote[inst] then return end
        if prop == "_CS_Id" or prop == "_CS_ParentId" then return end
        if State.partThrottle[inst] then return end
        State.partThrottle[inst] = true
        task.delay(0.15, function()
            State.partThrottle[inst] = nil
            if State.applyingRemote[inst] then return end
            if not inst.Parent then return end
            local s = serializeInstance(inst)
            if s then sendDelta("update", s) end
        end)
    end
    inst.Changed:Connect(function(prop) scheduleUpdate(prop) end)
    if inst:IsA("BasePart") then
        pcall(function()
            inst:GetPropertyChangedSignal("CFrame"):Connect(function() scheduleUpdate("CFrame") end)
            inst:GetPropertyChangedSignal("Position"):Connect(function() scheduleUpdate("Position") end)
            inst:GetPropertyChangedSignal("Name"):Connect(function() scheduleUpdate("Name") end)
            inst:GetPropertyChangedSignal("Reflectance"):Connect(function() scheduleUpdate("Reflectance") end)
            inst:GetPropertyChangedSignal("CastShadow"):Connect(function() scheduleUpdate("CastShadow") end)
            inst:GetPropertyChangedSignal("Locked"):Connect(function() scheduleUpdate("Locked") end)
        end)
    end
    if inst:IsA("DataModelMesh") then
        pcall(function()
            inst:GetPropertyChangedSignal("Scale"):Connect(function() scheduleUpdate("Scale") end)
            inst:GetPropertyChangedSignal("MeshId"):Connect(function() scheduleUpdate("MeshId") end)
            inst:GetPropertyChangedSignal("TextureId"):Connect(function() scheduleUpdate("TextureId") end)
        end)
    end
    if inst:IsA("Motor6D") then
        pcall(function()
            inst:GetPropertyChangedSignal("C0"):Connect(function() scheduleUpdate("C0") end)
            inst:GetPropertyChangedSignal("C1"):Connect(function() scheduleUpdate("C1") end)
        end)
    end
    inst.AttributeChanged:Connect(function(attr)
        if attr == "_CS_Id" or attr == "_CS_ParentId" or attr == "_CS_Skip" or attr == "_CS_OrigName" or attr == "_CS_OrigText" then return end
        if State.applyingRemote[inst] then return end
        local s = serializeInstance(inst)
        if s then sendDelta("update", s) end
    end)
end

--=== helper: mesh retry (independent checks) ===
local function spawnMeshRetry(inst, props, attempts)
    if not props then return end
    local targetMesh = props.MeshId
    local targetTex = props.TextureID or props.TextureId
    local targetSize = props.Size
    local targetScale = props.Scale
    if not (targetMesh or targetTex or targetSize or targetScale) then return end
    task.spawn(function()
        for _ = 1, (attempts or 40) do
            task.wait(0.15)
            if not inst or not inst.Parent then return end
            local done = true
            if targetMesh then
                local cur = ""
                pcall(function()
                    if inst:IsA("MeshPart") then cur = inst.MeshId
                    elseif inst:IsA("DataModelMesh") then cur = inst.MeshId end
                end)
                local norm = normalizeMeshId(targetMesh) or targetMesh
                if cur ~= norm then
                    pcall(function()
                        if inst:IsA("MeshPart") then inst.MeshId = norm
                        elseif inst:IsA("DataModelMesh") then inst.MeshId = norm end
                    end)
                    done = false
                end
            end
            if targetTex then
                local cur = ""
                pcall(function()
                    if inst:IsA("MeshPart") then cur = inst.TextureID
                    elseif inst:IsA("DataModelMesh") then cur = inst.TextureId end
                end)
                local norm = normalizeMeshId(targetTex) or targetTex
                if cur ~= norm then
                    pcall(function()
                        if inst:IsA("MeshPart") then inst.TextureID = norm
                        elseif inst:IsA("DataModelMesh") then inst.TextureId = norm end
                    end)
                    done = false
                end
            end
            if targetSize and inst:IsA("BasePart") then
                local tS = Vector3.new(unpack(targetSize))
                if (inst.Size - tS).Magnitude > 0.01 then
                    pcall(function() inst.Size = tS end)
                    done = false
                end
            end
            if targetScale and inst:IsA("DataModelMesh") then
                local tS = Vector3.new(unpack(targetScale))
                if (inst.Scale - tS).Magnitude > 0.01 then
                    pcall(function() inst.Scale = tS end)
                    done = false
                end
            end
            if done then break end
        end
    end)
end

applyDelta = function(delta)
    if not delta or not delta.id then return end
    if State.applyingRemote[delta.id] then return end
    State.applyingRemote[delta.id] = true
    local ok, err = pcall(function()
        if delta.kind == "camera" then
            if delta.userId ~= MY_ID and delta.cframe then
                if not State.synced then return end
                if not State.localMarkers[delta.userId] then createLocalMarker(delta.userId, resolveName(delta.userId)) end
                updateLocalMarker(delta.userId, CFrame.new(unpack(delta.cframe)))
            end
            return
        end
        sanitizeProps(delta.props)
        
        if delta.kind == "create" then
            local existing = State.objectMap[delta.id]
            if existing and existing.Parent then return end
            if existing and not existing.Parent then
                local parent
                if delta.parentId == "game" then parent = game
                elseif delta.parentId:match("^service:") then parent = game:GetService(delta.parentId:sub(9))
                else parent = State.objectMap[delta.parentId] end
                if parent then pcall(function() existing.Parent = parent end) end
                return
            end
            if SKIP_CLASSES[delta.className] then return end
            
            if delta.className == "__ToolboxModel__" and delta.props and delta.props.assetId then
                local assetId = tonumber(delta.props.assetId)
                if assetId then
                    local loaded = false
                    pcall(function()
                        local model = InsertService:LoadAsset(assetId)
                        if model then
                            local firstChild = model:GetChildren()[1]
                            if firstChild then
                                local parent
                                if delta.parentId == "game" then parent = game
                                elseif delta.parentId:match("^service:") then parent = game:GetService(delta.parentId:sub(9))
                                else parent = State.objectMap[delta.parentId] end
                                if parent then
                                    firstChild.Name = delta.name
                                    firstChild:SetAttribute("_CS_Id", delta.id)
                                    firstChild:SetAttribute("_CS_ToolboxAssetId", tostring(assetId))
                                    firstChild.Parent = parent
                                    State.objectMap[delta.id] = firstChild
                                    loaded = true
                                    logMsg("lobby", "info", "Toolbox загружен: "..delta.name.." (assetId="..assetId..")")
                                end
                            end
                            model:Destroy()
                        end
                    end)
                    if not loaded then logMsg("plugin", "warn", "Toolbox load failed for "..delta.name) end
                end
                return
            end
            
            local success, newInst = pcall(function() return Instance.new(delta.className) end)
            if success and newInst then
                newInst.Name = delta.name
                newInst:SetAttribute("_CS_Id", delta.id)
                newInst:SetAttribute("_CS_ParentId", delta.parentId)
                applyProps(newInst, delta.props, delta.attrs)
                local parent
                if delta.parentId == "game" then parent = game
                elseif delta.parentId:match("^service:") then parent = game:GetService(delta.parentId:sub(9))
                else parent = State.objectMap[delta.parentId] end
                if parent then
                    State.applyingRemote[newInst] = true
                    local ok2 = pcall(function() newInst.Parent = parent end)
                    if not ok2 then newInst:Destroy(); return end
                    task.delay(0.15, function() State.applyingRemote[newInst] = nil end)
                end
                State.objectMap[delta.id] = newInst
                watchInstance(newInst)
                if (delta.className == "MeshPart" or delta.className == "SpecialMesh") and delta.props then
                    spawnMeshRetry(newInst, delta.props, 40)
                end
                if (delta.className == "Motor6D" or delta.className == "Weld" or delta.className == "Snap") and delta.props then
                    task.spawn(function()
                        for _ = 1, 15 do
                            task.wait(0.1)
                            if not newInst or not newInst.Parent then return end
                            if delta.props.Part0Id and not newInst.Part0 then local p0 = State.objectMap[delta.props.Part0Id]; if p0 then pcall(function() newInst.Part0 = p0 end) end end
                            if delta.props.Part1Id and not newInst.Part1 then local p1 = State.objectMap[delta.props.Part1Id]; if p1 then pcall(function() newInst.Part1 = p1 end) end end
                        end
                    end)
                end
                if delta.userId ~= MY_ID and (delta.parentId == "game" or delta.parentId:match("^service:")) then
                    local msg = formatName(delta.userId).." создал "..(delta.name or "объект")
                    logMsg("lobby", "action", msg)
                    if Main then showToast(Main, msg, T.success) end
                end
            end
        elseif delta.kind == "update" then
            local inst = State.objectMap[delta.id]
            if inst then
                State.applyingRemote[inst] = true
                applyProps(inst, delta.props, delta.attrs)
                if delta.name and inst.Name ~= delta.name then pcall(function() inst.Name = delta.name end) end
                if (inst:IsA("MeshPart") or inst:IsA("DataModelMesh")) and delta.props then
                    spawnMeshRetry(inst, delta.props, 20)
                end
                task.delay(0.1, function() State.applyingRemote[inst] = nil end)
            end
        elseif delta.kind == "delete" then
            local inst = State.objectMap[delta.id]
            if inst then
                if delta.userId ~= MY_ID and inst.Parent and inst.Parent.Parent == game then
                    local msg = formatName(delta.userId).." удалил "..(inst.Name or "объект")
                    logMsg("lobby", "action", msg)
                    if Main then showToast(Main, msg, T.warn) end
                end
                if inst.Parent then pcall(function() inst:Destroy() end) end
            end
            State.objectMap[delta.id] = nil
        elseif delta.kind == "select" then
            local inst = State.objectMap[delta.id]
            if inst and inst.Parent then
                local selName = "_CS_Sel_"..delta.userId
                local existing = inst:FindFirstChild(selName)
                if delta.active then
                    if not existing then
                        local hl = Instance.new("Highlight")
                        hl.Name = selName; hl.FillColor = sphereColor(delta.userId); hl.OutlineColor = sphereColor(delta.userId)
                        hl.FillTransparency = 0.7; hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = inst; hl:SetAttribute("_CS_Skip", true); hl.Parent = inst
                    end
                else if existing then existing:Destroy() end end
            end
        end
    end)
    if not ok then logMsg("plugin", "error", "applyDelta: "..tostring(err)) end
    State.applyingRemote[delta.id] = nil
end

local function startWatching()
    for _, svc in ipairs(SYNC_SERVICES) do
        for _, inst in ipairs(svc:GetDescendants()) do watchInstance(inst) end
        svc.DescendantAdded:Connect(function(inst)
            if inst.Name:match("^_CS_") then return end
            if hasSkipAncestor(inst) then return end
            if shouldSkip(inst) then return end
            if State.applyingSnapshot then return end
            if State.applyingRemote[inst] then return end
            if not State.connected then return end
            if not State.watched[inst] then
                local s = serializeInstance(inst)
                if s then sendDelta("create", s) end
                watchInstance(inst)
            end
        end)
        svc.DescendantRemoving:Connect(function(inst)
            if inst.Name:match("^_CS_") then return end
            if hasSkipAncestor(inst) then return end
            if State.applyingSnapshot then return end
            if State.applyingRemote[inst] then return end
            local id = inst:GetAttribute("_CS_Id")
            if id then sendDelta("delete", {id=id}); State.objectMap[id] = nil end
        end)
    end
end

onSelectionChanged = function()
    if not State.connected then return end
    for _, inst in pairs(State.selectionMap[MY_ID] or {}) do
        if inst and inst.Parent then
            local id = inst:GetAttribute("_CS_Id")
            if id then sendDelta("select", {id=id, active=false, userId=MY_ID}) end
        end
    end
    State.selectionMap[MY_ID] = {}
    if not Selection then return end
    for _, inst in ipairs(Selection:Get()) do
        if not inst.Name:match("^_CS_") and not hasSkipAncestor(inst) then
            local id = inst:GetAttribute("_CS_Id")
            if id then sendDelta("select", {id=id, active=true, userId=MY_ID}); table.insert(State.selectionMap[MY_ID], inst) end
        end
    end
end

