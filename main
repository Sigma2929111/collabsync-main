local function logMsg(scope, level, text)
    local entry = {scope=scope, level=level, text=tostring(text), time=os.date("%H:%M:%S")}
    table.insert(State.logs, entry)
    if #State.logs > 500 then table.remove(State.logs, 1) end
    local prefix = "[CollabSync]"
    if scope == "lobby" then prefix = prefix .. " [Lobby]" end
    if level == "error" or level == "warn" then warn(prefix.." "..text) else print(prefix.." "..text) end
    if _G.__collabsync_update_logs then pcall(_G.__collabsync_update_logs) end
end
logMsg("plugin", "info", "MY_ID="..tostring(MY_ID).." NAME="..MY_NAME)

--==================================================================
-- Server1 role fetch (source of truth for roles)
--==================================================================
local function fetchRoles(uid, name, cb)
    task.spawn(function()
        local url = CATALOG_URL.."/api/user/roles?userId="..tostring(uid or "").."&userName="..HttpService:UrlEncode(tostring(name or ""))
        local ok, res = pcall(function()
            return HttpService:RequestAsync({Url=url, Method="GET", Headers={["Content-Type"]="application/json"}})
        end)
        local decoded = nil
        if ok and res and res.Success then
            local dok, dres = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if dok and type(dres) == "table" then decoded = dres end
        end
        if cb then pcall(cb, decoded) end
    end)
end

-- Fetch MY roles on init (before lobby join), refresh UI when arrived
fetchRoles(MY_ID, MY_NAME, function(r)
    if r then
        MY_ROLES.isOwner = r.isOwner or false
        MY_ROLES.isTester = r.isTester or false
        MY_ROLES.isBomb = r.isBomb or false
        MY_ROLES.isTrash = r.isTrash or false
        MY_ROLES.isBanned = r.isBanned or false
        logMsg("plugin", "info", "MY_ROLES from server1: owner="..tostring(MY_ROLES.isOwner).." tester="..tostring(MY_ROLES.isTester).." banned="..tostring(MY_ROLES.isBanned))
        if _G.__collabsync_refresh_styles then pcall(_G.__collabsync_refresh_styles) end
    end
end)

if PLUGIN and MY_ROLES.isOwner then
    pcall(function()
        local json = PLUGIN:GetSetting("cs_blacklist")
        if json and json ~= "" then
            local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
            if ok and type(decoded) == "table" then State.blacklist = decoded end
        end
    end)
end
local function saveBlacklist()
    if PLUGIN and MY_ROLES.isOwner then
        pcall(function() PLUGIN:SetSetting("cs_blacklist", HttpService:JSONEncode(State.blacklist)) end)
    end
end
local function isBlacklisted(uid, name)
    if not MY_ROLES.isOwner then return false end
    return State.blacklist[tostring(uid)] or State.blacklist[name]
end

