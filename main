    if not State.session or not isOwnLobby then return end
    pcall(function() State.wsClient:Send(HttpService:JSONEncode({type="kick", targetUserId=uid})) end)
end

refreshPlayerList = function()
    for _, ch in ipairs(pList:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
    local players = State.remotePlayers
    if #players == 0 then players = {{userId=MY_ID, userName=MY_NAME, isHost=isOwnLobby, roles=MY_ROLES}} end
    for _, p in ipairs(players) do
        local row = I("Frame", {Size=UDim2.new(1,0,0,44), BackgroundColor3=T.surf2, BorderSizePixel=0}, pList)
        round(row, 8)
        avatar(row, 28, p.userId).Position = UDim2.fromOffset(6,8)
        local nLbl = lbl(row, formatName(p.userId), {textSize=13, size=UDim2.new(1,-140,0,18), pos=UDim2.fromOffset(42,6), truncate=true})
        applyNameStyle(nLbl, p.userId)
        if isOwnLobby and p.userId ~= MY_ID then
            local kickBtn = btn(row, "Кикнуть", {size=UDim2.fromOffset(80,24), pos=UDim2.new(1,-88,0.5,-12), bg=T.surface, hoverBg=T.danger, textSize=11, zIndex=5})
            kickBtn.MouseButton1Click:Connect(function() kickPlayer(p.userId) end)
        end
    end
end
