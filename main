local loadingOverlay = nil
local function showLoadingSteps(title, steps, onComplete, onError)
    if loadingOverlay then loadingOverlay:Destroy() end
    loadingOverlay = I("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.55, BorderSizePixel=0, ZIndex=200}, root)
    local box = I("Frame", {Size=UDim2.fromOffset(420,240), Position=UDim2.fromScale(0.5,0.5), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=T.surface, BorderSizePixel=0, ZIndex=201}, loadingOverlay)
    round(box, 12); outline(box, T.border, 1)
    lbl(box, title, {font=Enum.Font.GothamBold, textSize=17, size=UDim2.new(1,-40,0,26), pos=UDim2.fromOffset(20,18), zIndex=202})
    local stepLbl = lbl(box, "Подготовка...", {textSize=12, color=T.muted, size=UDim2.new(1,-40,0,20), pos=UDim2.fromOffset(20,50), zIndex=202})
    local pb = I("Frame", {Size=UDim2.new(1,-40,0,10), Position=UDim2.fromOffset(20,88), BackgroundColor3=T.surf3, BorderSizePixel=0, ZIndex=202}, box); round(pb, 5)
    local pf = I("Frame", {Size=UDim2.fromScale(0,1), BackgroundColor3=T.accent, BorderSizePixel=0, ZIndex=203}, pb); round(pf, 5)
    local pct = lbl(box, "0%", {textSize=12, color=T.accent, font=Enum.Font.GothamBold, size=UDim2.new(1,-40,0,18), pos=UDim2.fromOffset(20,108), zIndex=202, xAlign=Enum.TextXAlignment.Right})
    local logLbl = lbl(box, "", {textSize=11, color=T.muted, wrapped=true, size=UDim2.new(1,-40,0,40), pos=UDim2.fromOffset(20,136), zIndex=202, autoSize=Enum.AutomaticSize.Y})
    local cancelled = false
    local function finish(ok, err)
        if ok then if loadingOverlay then loadingOverlay:Destroy() end; loadingOverlay = nil; if onComplete then pcall(onComplete) end
        else stepLbl.Text = "ОШИБКА"; pf.BackgroundColor3 = T.danger; logLbl.Text = "✗ "..tostring(err); logLbl.TextColor3 = T.danger; logMsg("plugin", "error", tostring(err)); task.wait(1.5); if loadingOverlay then loadingOverlay:Destroy() end; loadingOverlay = nil; if onError then pcall(onError, err) end end
    end
    task.spawn(function()
        for i, step in ipairs(steps) do
            if cancelled then return end
            local p = math.floor(((i-1)/#steps)*100)
            pf.Size = UDim2.fromScale(p/100, 1); pct.Text = p.."%"; stepLbl.Text = step.label; logLbl.Text = "→ "..step.label
            local ok, sOk, sErr = pcall(step.fn)
            if not ok then finish(false, "Крит: "..tostring(sOk)); return
            elseif sOk == false then finish(false, sErr or "?"); return end
            task.wait(0.05)
        end
        pf.Size = UDim2.fromScale(1, 1); pct.Text = "100%"; stepLbl.Text = "Готово"; logLbl.Text = "✓ Активно"; logLbl.TextColor3 = T.success
        task.wait(0.35); finish(true)
    end)
end

local function promptPassword(onSuccess)
    local ov = I("Frame", {Size=UDim2.fromScale(1,1), BackgroundColor3=Color3.new(0,0,0), BackgroundTransparency=0.55, BorderSizePixel=0, ZIndex=250}, root)
    local dlg = I("Frame", {Size=UDim2.fromOffset(360,190), Position=UDim2.fromScale(0.5,0.5), AnchorPoint=Vector2.new(0.5,0.5), BackgroundColor3=T.surface, BorderSizePixel=0, ZIndex=251}, ov)
    round(dlg, 12); outline(dlg, T.border, 1)
    lbl(dlg, "Пароль", {font=Enum.Font.GothamBold, textSize=17, size=UDim2.new(1,-40,0,26), pos=UDim2.fromOffset(20,18), zIndex=252})
    local box = I("Frame", {Size=UDim2.new(1,-40,0,40), Position=UDim2.fromOffset(20,74), BackgroundColor3=T.surf2, BorderSizePixel=0, ZIndex=252}, dlg); round(box, 8); outline(box, T.border, 1)
    local tb = I("TextBox", {Size=UDim2.new(1,-20,1,0), Position=UDim2.fromOffset(10,0), BackgroundTransparency=1, BorderSizePixel=0, Font=Enum.Font.Gotham, TextSize=14, TextColor3=T.text, PlaceholderText="Пароль", PlaceholderColor3=T.muted, Text="", ClearTextOnFocus=false, ZIndex=253}, box)
    local cancel = btn(dlg, "Отмена", {size=UDim2.fromOffset(130,38), pos=UDim2.fromOffset(20,130), bg=T.surf2, hoverBg=T.border, textSize=13, zIndex=252})
    local ok = btn(dlg, "Войти", {size=UDim2.new(1,-170,0,38), pos=UDim2.fromOffset(160,130), bg=T.accent, hoverBg=T.accent2, textSize=13, zIndex=252})
    local function close() ov:Destroy() end
    cancel.MouseButton1Click:Connect(close)
    ok.MouseButton1Click:Connect(function() local p = tb.Text; close(); if p ~= "" then onSuccess(p) end end)
    tb.FocusLost:Connect(function(e) if e then local p = tb.Text; close(); if p ~= "" then onSuccess(p) end end end)
    tb:CaptureFocus()
end

