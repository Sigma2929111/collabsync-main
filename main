local whitelist = I("Frame", {Size=UDim2.new(1,0,1,-190), Position=UDim2.fromOffset(0,54), BackgroundColor3=T.surface, BorderSizePixel=0}, SPlace)
round(whitelist, 10); outline(whitelist, T.border, 1); pad(whitelist, 10)
