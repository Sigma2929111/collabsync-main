const express = require("express");
const jwt = require("jsonwebtoken");
const bcrypt = require("bcryptjs");
const crypto = require("crypto");
const fs = require("fs");
const path = require("path");
const app = express();
app.use(express.json({ limit: "5mb" }));
const PORT = process.env.PORT || 3000;
const JWT_SECRET = process.env.JWT_SECRET || "";
const ADMIN_SECRET = process.env.ADMIN_SECRET || "";
if (JWT_SECRET.length < 32) throw new Error("JWT_SECRET must be set and contain at least 32 characters");
if (ADMIN_SECRET.length < 32) throw new Error("ADMIN_SECRET must be set and contain at least 32 characters");
const CATALOG_PUBLIC_URL = process.env.CATALOG_PUBLIC_URL || "";
const HEARTBEAT_TIMEOUT_MS = 45000;
const DATA_DIR = process.env.COLLABSYNC_DATA_DIR || path.join(__dirname, ".collabsync-data");
const STATE_FILE = path.join(DATA_DIR, "catalog-state.json");
let persistTimer = null, persistQueue = Promise.resolve();
async function flushPersistentLobbies() {
    if (persistTimer) { clearTimeout(persistTimer); persistTimer = null; }
    const state = { version: 1, lobbies: [...lobbies.values()].filter(l => l.persistent) };
    const data = JSON.stringify(state);
    persistQueue = persistQueue.catch(() => {}).then(async () => {
        await fs.promises.mkdir(DATA_DIR, { recursive: true });
        const tmp = STATE_FILE + ".tmp";
        await fs.promises.writeFile(tmp, data, { mode: 0o600 });
        await fs.promises.rename(tmp, STATE_FILE);
    });
    await persistQueue;
}
function schedulePersist() {
    if (persistTimer) clearTimeout(persistTimer);
    persistTimer = setTimeout(() => { persistTimer = null; flushPersistentLobbies().catch(e => console.error("[Persistence] catalog save failed:", e.message)); }, 250);
}
async function restorePersistentLobbies() {
    try {
        const state = JSON.parse(await fs.promises.readFile(STATE_FILE, "utf8"));
        if (state.version !== 1 || !Array.isArray(state.lobbies)) throw new Error("unsupported catalog state format");
        for (const lobby of state.lobbies) if (lobby && typeof lobby.id === "string" && lobby.persistent === true && Number.isSafeInteger(Number(lobby.hostId))) lobbies.set(lobby.id, lobby);
        console.log(`[Persistence] restored ${lobbies.size} persistent catalog lobbies`);
    } catch (e) { if (e.code !== "ENOENT") console.error("[Persistence] catalog restore failed:", e.message); }
}

// Тестеры получают режим просмотра; специальные декоративные роли удалены.
const TESTER_IDS = new Set((process.env.TESTER_IDS || "").split(",").map(s=>s.trim()).filter(Boolean));

const lobbies = new Map();
const bannedUsers = new Set();
const rateLimit = new Map();

function now() { return Date.now(); }

function getUserRoles(userId, userName) {
    const idStr = String(userId || "");
    const name = String(userName || "");
    return {
        isTester: TESTER_IDS.has(idStr),
        isBanned: bannedUsers.has(idStr) || bannedUsers.has(name),
    };
}

app.use((req, res, next) => {
    res.header("Access-Control-Allow-Origin", "*");
    res.header("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Admin-Key");
    res.header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS");
    if (req.method === "OPTIONS") return res.sendStatus(204);
    next();
});

app.use((req, res, next) => {
    if (req.path === "/health") return next();
    const ip = req.ip || "unknown";
    const key = ip + ":" + req.path;
    const t = now();
    let entry = rateLimit.get(key);
    if (!entry || t > entry.reset) { entry = { count: 0, reset: t + 60000 }; rateLimit.set(key, entry); }
    entry.count++;
    if (entry.count > 120) return res.status(429).json({ error: "rate limited" });
    next();
});

const cleanupTimer = setInterval(() => {
    const t = now();
    for (const [id, l] of lobbies.entries()) {
        if (!l.persistent && t - l.lastPing > HEARTBEAT_TIMEOUT_MS) { 
            lobbies.delete(id); 
            console.log(`[cleanup] lobby ${id} expired`); 
        }
    }
    schedulePersist();
}, 15000);

app.get("/health", (req, res) => res.json({ ok: true, ts: now(), lobbies: lobbies.size }));

app.post("/api/lobby/create", async (req, res) => {
    try {
        const { name, hostId, hostName, password, isPrivate, hostUrl, placeId, placeName, persistent } = req.body || {};
        const hostUid = Number(hostId);
        if (!name || !Number.isSafeInteger(hostUid) || hostUid <= 0) return res.status(400).json({ error: "valid name and hostId required" });
        if (String(name).length > 100) return res.status(400).json({ error: "name too long" });
        
        const roles = getUserRoles(hostUid, hostName);
        if (roles.isBanned) return res.status(403).json({ error: "banned" });
        if (roles.isTester) return res.status(403).json({ error: "testers are read-only and cannot host edit lobbies" });
        
        const lobbyId = crypto.randomUUID();
        const passwordHash = password ? await bcrypt.hash(String(password), 10) : null;
        
        const lobby = {
            id: lobbyId, name: String(name),
            hostId: hostUid, hostName: String(hostName || hostUid).slice(0, 32),
            passwordHash, isPrivate: !!isPrivate,
            hostUrl: hostUrl || null, placeId: placeId || null, placeName: placeName || null,
            createdAt: now(), lastPing: now(), persistent: persistent === true,
        };
        lobbies.set(lobbyId, lobby);
        schedulePersist();
        
        // JWT строго содержит isHost: true только для создателя
        const token = jwt.sign({ 
            lobbyId, userId: lobby.hostId, userName: lobby.hostName, isHost: true, isTester: false, lobbyName: lobby.name, persistent: lobby.persistent === true 
        }, JWT_SECRET, { expiresIn: "12h" });
        
        res.json({ lobbyId, token, hostUrl: lobby.hostUrl, persistent: lobby.persistent === true });
    } catch (e) { res.status(500).json({ error: String(e) }); }
});

app.post("/api/lobby/join", async (req, res) => {
    const { lobbyId, userId, userName, password } = req.body || {};
    const uid = Number(userId);
    if (!lobbyId || !Number.isSafeInteger(uid) || uid <= 0) return res.status(400).json({ error: "valid lobbyId and userId required" });
    const lobby = lobbies.get(lobbyId);
    if (!lobby) return res.status(404).json({ error: "lobby not found" });

    const safeName = String(userName || uid).slice(0, 32);
    const roles = getUserRoles(uid, safeName);
    if (roles.isBanned) return res.status(403).json({ error: "banned" });
    
    if (lobby.passwordHash) {
        if (!password) return res.status(401).json({ error: "password required" });
        const ok = await bcrypt.compare(String(password), lobby.passwordHash);
        if (!ok) return res.status(403).json({ error: "invalid password" });
    }
    
    if (!lobby.persistent && now() - lobby.lastPing > HEARTBEAT_TIMEOUT_MS) {
        lobbies.delete(lobbyId);
        return res.status(410).json({ error: "lobby expired" });
    }
    
    // Только исходный владелец лобби может повторно получить host-токен.
    const joiningAsHost = uid === lobby.hostId;
    const token = jwt.sign({
        lobbyId, userId: uid, userName: safeName,
        isHost: joiningAsHost, isTester: joiningAsHost ? false : roles.isTester,
        lobbyName: lobby.name, persistent: lobby.persistent === true
    }, JWT_SECRET, { expiresIn: "12h" });

    res.json({
        token, hostUrl: lobby.hostUrl, lobbyId, lobbyName: lobby.name,
        hostName: lobby.hostName, hostId: lobby.hostId,
        isHost: joiningAsHost, persistent: lobby.persistent === true
    });
});

app.get("/api/lobby/list", (req, res) => {
    const t = now();
    const list = [];
    for (const l of lobbies.values()) {
        if (l.isPrivate) continue;
        if (!l.persistent && t - l.lastPing > HEARTBEAT_TIMEOUT_MS) continue;
        list.push({
            id: l.id, name: l.name, hostName: l.hostName, hostId: l.hostId,
            hasPassword: !!l.passwordHash, placeName: l.placeName, placeId: l.placeId,
            hostUrl: l.hostUrl, createdAt: l.createdAt, persistent: l.persistent === true,
        });
    }
    list.sort((a, b) => b.createdAt - a.createdAt);
    res.json({ lobbies: list });
});

app.post("/api/lobby/heartbeat", (req, res) => {
    const { lobbyId } = req.body || {};
    const lobby = lobbies.get(lobbyId);
    if (!lobby) return res.status(404).json({ error: "not found" });
    const auth = String(req.headers.authorization || "");
    const token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    let decoded;
    try { decoded = jwt.verify(token, JWT_SECRET); } catch (_) {
        return res.status(401).json({ error: "unauthorized" });
    }
    if (!decoded.isHost || decoded.lobbyId !== lobbyId || Number(decoded.userId) !== lobby.hostId) {
        return res.status(403).json({ error: "forbidden" });
    }
    lobby.lastPing = now();
    schedulePersist();
    res.json({ ok: true });
});

app.post("/api/lobby/delete", (req, res) => {
    const { lobbyId } = req.body || {};
    const lobby = lobbies.get(lobbyId);
    if (!lobby) return res.status(404).json({ error: "not found" });
    const auth = String(req.headers.authorization || "");
    const token = auth.startsWith("Bearer ") ? auth.slice(7) : "";
    let decoded;
    try { decoded = jwt.verify(token, JWT_SECRET); } catch (_) {
        return res.status(401).json({ error: "unauthorized" });
    }
    if (!decoded.isHost || decoded.lobbyId !== lobbyId || Number(decoded.userId) !== lobby.hostId) {
        return res.status(403).json({ error: "forbidden" });
    }
    lobbies.delete(lobbyId);
    schedulePersist();
    res.json({ ok: true });
});

app.get("/api/user/roles", (req, res) => {
    const { userId, userName } = req.query;
    res.json(getUserRoles(userId, userName));
});

app.get("/api/user/roles/batch", (req, res) => {
    const uids = String(req.query.uids || "").split(",").map(s=>s.trim()).filter(Boolean);
    const names = String(req.query.names || "").split(",").map(s=>s.trim()).filter(Boolean);
    const out = {};
    for (const uid of uids) out[uid] = getUserRoles(uid, "");
    for (const name of names) out[name] = getUserRoles("", name);
    res.json(out);
});

function checkAdmin(req) { return req.headers["x-admin-key"] === ADMIN_SECRET; }

app.post("/api/admin/ban", (req, res) => {
    if (!checkAdmin(req)) return res.status(403).json({ error: "forbidden" });
    const { userId, userName } = req.body || {};
    if (userId) bannedUsers.add(String(userId));
    if (userName) bannedUsers.add(String(userName));
    res.json({ ok: true, banned: Array.from(bannedUsers) });
});

app.post("/api/admin/unban", (req, res) => {
    if (!checkAdmin(req)) return res.status(403).json({ error: "forbidden" });
    const { userId, userName } = req.body || {};
    if (userId) bannedUsers.delete(String(userId));
    if (userName) bannedUsers.delete(String(userName));
    res.json({ ok: true, banned: Array.from(bannedUsers) });
});

app.get("/api/admin/banlist", (req, res) => {
    if (!checkAdmin(req)) return res.status(403).json({ error: "forbidden" });
    res.json({ banned: Array.from(bannedUsers) });
});

const healthTimer = setInterval(() => {
    const url = CATALOG_PUBLIC_URL ? CATALOG_PUBLIC_URL + "/health" : `http://localhost:${PORT}/health`;
    fetch(url).catch(()=>{});
}, 10000);

restorePersistentLobbies().then(() => {
    const httpServer = app.listen(PORT, () => console.log(`[Catalog] listening ${PORT}`));
    async function shutdown(signal) {
        console.log(`[Shutdown] ${signal}: flushing catalog state...`);
        clearInterval(cleanupTimer);
        clearInterval(healthTimer);
        try { await flushPersistentLobbies(); }
        catch (e) { console.error("[Shutdown] catalog flush failed:", e.message); process.exitCode = 1; }
        httpServer.close(() => process.exit(process.exitCode || 0));
        setTimeout(() => { httpServer.closeAllConnections?.(); process.exit(process.exitCode || 0); }, 1500).unref();
    }
    process.once("SIGINT", () => shutdown("SIGINT"));
    process.once("SIGTERM", () => shutdown("SIGTERM"));
}).catch(err => { console.error("[Persistence] catalog startup failed:", err); process.exit(1); });
